{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval_health_slice_trend_v1",
  "type": "object",
  "required": [
    "trend_run_id",
    "trend_run_timestamp_utc",
    "scenario",
    "source_area",
    "resource_id",
    "city",
    "requested_horizon_minutes",
    "model_name",
    "feature_contract_version",
    "target_coverage_level",
    "interval_contract_version",
    "monitor_run_id",
    "monitor_status",
    "failed_error_check_count",
    "failed_warning_check_count",
    "interval_run_count",
    "recent_interval_run_count",
    "reference_interval_run_count",
    "reference_history_sufficient",
    "latest_interval_run_id",
    "latest_interval_run_timestamp_utc",
    "latest_evaluation_end_utc",
    "latest_empirical_coverage_pct",
    "latest_coverage_shortfall_pct_points",
    "latest_average_interval_width_mw",
    "latest_calibration_observation_count",
    "recent_empirical_coverage_pct",
    "recent_average_interval_width_mw",
    "recent_mean_calibration_observation_count",
    "recent_minimum_calibration_observation_count",
    "reference_empirical_coverage_pct",
    "reference_average_interval_width_mw",
    "reference_mean_calibration_observation_count",
    "coverage_drop_pct_points",
    "average_interval_width_increase_pct",
    "calibration_history_drop_pct",
    "attention_required",
    "trend_contract_version"
  ],
  "properties": {
    "trend_run_id": {"type": "string", "pattern": "^iht-[0-9a-f]{24}$"},
    "trend_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "scenario": {"enum": ["healthy", "warning", "failed"]},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "requested_horizon_minutes": {"type": "integer", "minimum": 1},
    "model_name": {"type": "string", "minLength": 1},
    "feature_contract_version": {"type": "string", "minLength": 1},
    "target_coverage_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "interval_contract_version": {"type": "string", "minLength": 1},
    "monitor_run_id": {"type": "string", "minLength": 1},
    "monitor_status": {"enum": ["healthy", "warning", "failed"]},
    "failed_error_check_count": {"type": "integer", "minimum": 0},
    "failed_warning_check_count": {"type": "integer", "minimum": 0},
    "interval_run_count": {"type": "integer", "minimum": 1},
    "recent_interval_run_count": {"type": "integer", "minimum": 1},
    "reference_interval_run_count": {"type": "integer", "minimum": 0},
    "reference_history_sufficient": {"type": "boolean"},
    "latest_interval_run_id": {"type": "string", "minLength": 1},
    "latest_interval_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "latest_evaluation_end_utc": {"type": "string", "format": "date-time"},
    "latest_empirical_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "latest_coverage_shortfall_pct_points": {"type": "number", "minimum": 0, "maximum": 100},
    "latest_average_interval_width_mw": {"type": "number", "minimum": 0},
    "latest_calibration_observation_count": {"type": "integer", "minimum": 1},
    "recent_empirical_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "recent_average_interval_width_mw": {"type": "number", "minimum": 0},
    "recent_mean_calibration_observation_count": {"type": "number", "minimum": 1},
    "recent_minimum_calibration_observation_count": {"type": "integer", "minimum": 1},
    "reference_empirical_coverage_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "reference_average_interval_width_mw": {"type": ["number", "null"], "minimum": 0},
    "reference_mean_calibration_observation_count": {"type": ["number", "null"], "minimum": 1},
    "coverage_drop_pct_points": {"type": ["number", "null"]},
    "average_interval_width_increase_pct": {"type": ["number", "null"]},
    "calibration_history_drop_pct": {"type": ["number", "null"]},
    "attention_required": {"type": "boolean"},
    "trend_contract_version": {"const": "interval-health-trend-v1"}
  },
  "additionalProperties": false
}
