{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate_evidence_recovery_v1",
  "type": "object",
  "required": [
    "recovery_id",
    "bundle_id",
    "recovered_at_utc",
    "actor",
    "reason",
    "destination_name",
    "bundle_sha256",
    "bundle_manifest_hash",
    "candidate_id",
    "candidate_state",
    "recovered_entry_count",
    "recovered_total_entry_bytes",
    "recovery_status",
    "deployment_authorized",
    "active_model_unchanged",
    "source_files_mutated",
    "recovery_contract_version",
    "recovery_event_hash"
  ],
  "properties": {
    "recovery_id": {"type": "string", "pattern": "^rcv-[0-9a-f]{24}$"},
    "bundle_id": {"type": "string", "pattern": "^ceb-[0-9a-f]{24}$"},
    "recovered_at_utc": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "destination_name": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^twc-[0-9a-f]{24}$"},
    "candidate_state": {"const": "approved"},
    "recovered_entry_count": {"type": "integer", "minimum": 6},
    "recovered_total_entry_bytes": {"type": "integer", "minimum": 1},
    "recovery_status": {"const": "verified"},
    "deployment_authorized": {"const": false},
    "active_model_unchanged": {"const": true},
    "source_files_mutated": {"const": false},
    "recovery_contract_version": {"const": "candidate-evidence-recovery-v1"},
    "recovery_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
