{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval_policy_sensitivity_summary_v1",
  "type": "object",
  "required": [
    "sensitivity_run_id",
    "sensitivity_run_timestamp_utc",
    "trend_run_id",
    "scenario",
    "candidate_id",
    "candidate_role",
    "retained_monitor_status",
    "active_reference_status",
    "candidate_status",
    "status_changed_from_active",
    "sensitivity_classification",
    "slice_count",
    "changed_slice_count",
    "human_review_required",
    "sensitivity_contract_version",
    "active_policy_updated",
    "candidate_thresholds_activated",
    "retained_evidence_mutated",
    "interval_recalibration_performed",
    "model_change_performed",
    "schedule_change_performed",
    "promotion_change_performed",
    "alert_delivery_performed"
  ],
  "properties": {
    "sensitivity_run_id": {"type": "string", "pattern": "^ips-[0-9a-f]{24}$"},
    "sensitivity_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "trend_run_id": {"type": "string", "pattern": "^iht-[0-9a-f]{24}$"},
    "scenario": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_role": {"enum": ["active_reference", "review_candidate"]},
    "retained_monitor_status": {"enum": ["healthy", "warning", "failed"]},
    "active_reference_status": {"enum": ["healthy", "warning", "failed"]},
    "candidate_status": {"enum": ["healthy", "warning", "failed"]},
    "status_changed_from_active": {"type": "boolean"},
    "sensitivity_classification": {"enum": ["active_reference", "status_robust", "status_sensitive"]},
    "slice_count": {"type": "integer", "minimum": 1},
    "changed_slice_count": {"type": "integer", "minimum": 0},
    "human_review_required": {"type": "boolean"},
    "sensitivity_contract_version": {"const": "interval-policy-sensitivity-v1"},
    "active_policy_updated": {"const": false},
    "candidate_thresholds_activated": {"const": false},
    "retained_evidence_mutated": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "schedule_change_performed": {"const": false},
    "promotion_change_performed": {"const": false},
    "alert_delivery_performed": {"const": false}
  },
  "additionalProperties": true
}
