{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence_inventory_v1",
  "type": "object",
  "required": [
    "inventory_as_of_utc",
    "relative_path",
    "parent_path",
    "file_name",
    "suffix",
    "category",
    "classified",
    "size_bytes",
    "modified_at_utc",
    "age_days",
    "sha256",
    "min_keep_latest",
    "compaction_formats",
    "min_compaction_files",
    "max_compaction_source_bytes",
    "always_protect",
    "inventory_contract_version"
  ],
  "properties": {
    "inventory_as_of_utc": {"type": "string", "format": "date-time"},
    "relative_path": {"type": "string", "minLength": 1},
    "parent_path": {"type": "string"},
    "file_name": {"type": "string", "minLength": 1},
    "suffix": {"type": "string"},
    "category": {"type": "string", "minLength": 1},
    "classified": {"type": "boolean"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "modified_at_utc": {"type": "string", "format": "date-time"},
    "age_days": {"type": "number", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retention_days": {"type": ["integer", "null"], "minimum": 1},
    "min_keep_latest": {"type": "integer", "minimum": 0},
    "compact_after_days": {"type": ["integer", "null"], "minimum": 1},
    "compaction_formats": {"type": "string"},
    "min_compaction_files": {"type": "integer", "minimum": 0},
    "max_compaction_source_bytes": {"type": "integer", "minimum": 0},
    "always_protect": {"type": "boolean"},
    "inventory_contract_version": {"const": "evidence-inventory-v1"}
  },
  "additionalProperties": true
}
