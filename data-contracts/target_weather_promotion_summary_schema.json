{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "target_weather_promotion_summary_v1",
  "type": "object",
  "required": [
    "assessment_id",
    "assessment_timestamp_utc",
    "comparison_run_id",
    "reconciliation_run_id",
    "baseline_model",
    "candidate_model",
    "assessment_status",
    "automatic_promotion_allowed",
    "check_count",
    "passed_check_count",
    "failed_check_count",
    "evaluated_model_slice_count",
    "evaluated_weather_slice_count",
    "required_horizons",
    "required_lead_buckets",
    "require_test_split",
    "policy_version",
    "assessment_contract_version"
  ],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "assessment_timestamp_utc": {"type": "string", "format": "date-time"},
    "comparison_run_id": {"type": "string", "minLength": 1},
    "reconciliation_run_id": {"type": "string", "minLength": 1},
    "baseline_model": {"const": "ridge_weather_lag"},
    "candidate_model": {"const": "ridge_target_weather"},
    "assessment_status": {"enum": ["blocked", "eligible_for_human_review"]},
    "automatic_promotion_allowed": {"const": false},
    "check_count": {"type": "integer", "minimum": 1},
    "passed_check_count": {"type": "integer", "minimum": 0},
    "failed_check_count": {"type": "integer", "minimum": 0},
    "evaluated_model_slice_count": {"type": "integer", "minimum": 1},
    "evaluated_weather_slice_count": {"type": "integer", "minimum": 1},
    "required_horizons": {"type": "string", "minLength": 1},
    "required_lead_buckets": {"type": "string"},
    "require_test_split": {"type": "boolean"},
    "policy_version": {"const": "target-weather-promotion-policy-v1"},
    "assessment_contract_version": {"const": "target-weather-promotion-assessment-v1"}
  },
  "additionalProperties": true
}
