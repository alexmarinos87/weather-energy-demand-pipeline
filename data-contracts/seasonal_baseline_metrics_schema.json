{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "elapsed_seasonal_baseline_metrics_v1",
  "type": "object",
  "required": [
    "run_id",
    "run_timestamp_utc",
    "source_area",
    "resource_id",
    "city",
    "requested_horizon_minutes",
    "split",
    "model_name",
    "model_fit_required",
    "observation_count",
    "mae_mw",
    "rmse_mw",
    "bias_mw",
    "trained_through_utc",
    "training_observation_count",
    "evaluation_feature_start_utc",
    "evaluation_feature_end_utc",
    "evaluation_start_utc",
    "evaluation_end_utc",
    "feature_contract_version",
    "seasonal_reference_tolerance_minutes",
    "previous_day_coverage_pct",
    "previous_week_coverage_pct",
    "seasonal_baseline_contract_version",
    "evaluation_contract_version"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "run_timestamp_utc": {"type": "string", "format": "date-time"},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "requested_horizon_minutes": {"type": "integer", "enum": [30, 60]},
    "split": {"enum": ["validation", "test"]},
    "model_name": {
      "enum": [
        "persistence_current_value",
        "seasonal_previous_day",
        "seasonal_previous_week",
        "ridge_weather_lag"
      ]
    },
    "model_fit_required": {"type": "boolean"},
    "observation_count": {"type": "integer", "minimum": 1},
    "mae_mw": {"type": "number", "minimum": 0},
    "rmse_mw": {"type": "number", "minimum": 0},
    "mape_pct": {"type": ["number", "null"], "minimum": 0},
    "bias_mw": {"type": "number"},
    "trained_through_utc": {"type": "string", "format": "date-time"},
    "training_observation_count": {"type": "integer", "minimum": 1},
    "evaluation_feature_start_utc": {"type": "string", "format": "date-time"},
    "evaluation_feature_end_utc": {"type": "string", "format": "date-time"},
    "evaluation_start_utc": {"type": "string", "format": "date-time"},
    "evaluation_end_utc": {"type": "string", "format": "date-time"},
    "feature_contract_version": {"enum": ["time-horizon-v1", "time-horizon-uk-calendar-v1"]},
    "seasonal_reference_tolerance_minutes": {"type": "integer", "minimum": 0},
    "previous_day_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "previous_week_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "seasonal_baseline_contract_version": {"const": "elapsed-seasonal-v1"},
    "evaluation_contract_version": {"enum": ["fixed-holdout-v1", "rolling-origin-v1"]},
    "origin_fold": {"type": ["integer", "null"], "minimum": 1},
    "origin_count": {"type": ["integer", "null"], "minimum": 2},
    "origin_cutoff_utc": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
