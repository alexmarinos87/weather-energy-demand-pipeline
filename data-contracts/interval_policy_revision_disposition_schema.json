{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "active_policy_updated": {"const": false},
    "alert_delivery_performed": {"const": false},
    "candidate_thresholds_activated": {"const": false},
    "deployment_performed": {"const": false},
    "disposed_at_utc": {"format": "date-time", "type": "string"},
    "disposition": {
      "enum": [
        "retain_active_policy",
        "reject_revised_candidate",
        "request_another_revision",
        "suitable_for_separate_implementation_proposal"
      ]
    },
    "disposition_contract_version": {"const": "interval-policy-revision-disposition-v1"},
    "disposition_effect": {"minLength": 1, "type": "string"},
    "disposition_id": {"pattern": "^iprd-[0-9a-f]{24}$", "type": "string"},
    "disposition_revision": {"const": 1},
    "disposition_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "external_publication_performed": {"const": false},
    "follow_up_human_action_required": {"type": "boolean"},
    "implementation_applied": {"const": false},
    "implementation_authorized": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "named_human_review_confirmed": {"const": true},
    "promotion_change_performed": {"const": false},
    "rationale": {"minLength": 1, "type": "string"},
    "requested_actions": {
      "items": {"minLength": 10, "type": "string"},
      "type": "array",
      "uniqueItems": true
    },
    "retained_evidence_mutated": {"const": false},
    "review_ticket": {"minLength": 1, "type": "string"},
    "reviewer_name": {"minLength": 1, "type": "string"},
    "reviewer_role": {"minLength": 1, "type": "string"},
    "revised_candidate_id": {"minLength": 1, "type": "string"},
    "revised_candidate_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "revised_candidate_version": {"minLength": 1, "type": "string"},
    "revision_sensitivity_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "revision_sensitivity_summary_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "scenario_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "active_reference_status": {"enum": ["healthy", "warning", "failed"]},
          "changed_slice_count": {"minimum": 0, "type": "integer"},
          "human_review_required": {"type": "boolean"},
          "retained_monitor_status": {"enum": ["healthy", "warning", "failed"]},
          "scenario": {"minLength": 1, "type": "string"},
          "sensitivity_classification": {"minLength": 1, "type": "string"},
          "status_changed_from_active": {"type": "boolean"},
          "target_candidate_status": {"enum": ["healthy", "warning", "failed"]}
        },
        "required": [
          "scenario",
          "retained_monitor_status",
          "active_reference_status",
          "target_candidate_status",
          "status_changed_from_active",
          "sensitivity_classification",
          "changed_slice_count",
          "human_review_required"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schedule_change_performed": {"const": false},
    "sensitivity_run_id": {"minLength": 1, "type": "string"},
    "sensitivity_run_timestamp_utc": {"format": "date-time", "type": "string"},
    "source_decision_id": {"minLength": 1, "type": "string"},
    "source_manifest_mutated": {"const": false},
    "source_revision_package_id": {"minLength": 1, "type": "string"},
    "source_revision_review_id": {"minLength": 1, "type": "string"},
    "source_summary_mutated": {"const": false},
    "target_candidate_id": {"minLength": 1, "type": "string"},
    "threshold_activation_authorized": {"const": false},
    "trend_run_id": {"minLength": 1, "type": "string"}
  },
  "required": [
    "disposition_id",
    "disposition_revision",
    "sensitivity_run_id",
    "sensitivity_run_timestamp_utc",
    "trend_run_id",
    "revision_sensitivity_summary_sha256",
    "revision_sensitivity_manifest_sha256",
    "source_revision_review_id",
    "source_revision_package_id",
    "source_decision_id",
    "revised_candidate_id",
    "revised_candidate_version",
    "revised_candidate_sha256",
    "disposition",
    "disposition_effect",
    "target_candidate_id",
    "reviewer_name",
    "reviewer_role",
    "review_ticket",
    "rationale",
    "requested_actions",
    "disposed_at_utc",
    "scenario_evidence",
    "named_human_review_confirmed",
    "follow_up_human_action_required",
    "implementation_authorized",
    "implementation_applied",
    "threshold_activation_authorized",
    "active_policy_updated",
    "candidate_thresholds_activated",
    "source_manifest_mutated",
    "source_summary_mutated",
    "retained_evidence_mutated",
    "interval_recalibration_performed",
    "model_change_performed",
    "schedule_change_performed",
    "promotion_change_performed",
    "alert_delivery_performed",
    "deployment_performed",
    "external_publication_performed",
    "disposition_contract_version",
    "disposition_sha256"
  ],
  "title": "interval-policy-revision-disposition-v1",
  "type": "object"
}
