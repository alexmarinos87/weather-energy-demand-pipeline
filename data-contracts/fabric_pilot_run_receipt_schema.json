{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "controlled_fabric_pilot_run_receipt_v1",
  "type": "object",
  "required": [
    "receipt_id", "receipt_revision", "receipt_state", "pilot_id", "plan_hash",
    "preflight_id", "preflight_hash", "authorization_id", "authorization_hash",
    "candidate_id", "bundle_id", "recovery_id", "external_run_id", "operator",
    "run_status", "started_at_utc", "ended_at_utc", "duration_minutes",
    "environment", "workspace_name", "lakehouse_name", "capacity_name", "repository",
    "code_commit_sha", "code_tree_sha", "executed_notebook_paths", "written_tables",
    "credential_references_used", "forecast_record_count", "prediction_row_count",
    "metric_row_count", "failed_quality_check_count", "notebook_retry_count",
    "peak_capacity_units", "schedule_created", "deployment_performed",
    "model_activation_performed", "active_model_before", "active_model_after",
    "rollback_performed", "rollback_reason", "credential_values_included",
    "evidence_files", "recorded_at_utc", "single_use_authorization",
    "authorization_consumed", "execution_authorized", "execution_performed",
    "manual_execution_confirmed", "automatic_execution_used",
    "schedule_activation_allowed", "deployment_authorized",
    "model_activation_authorized", "credential_values_recorded",
    "source_evidence_mutated", "receipt_contract_version", "receipt_hash"
  ],
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^fpr-[0-9a-f]{24}$"},
    "receipt_revision": {"const": 1},
    "receipt_state": {"const": "recorded"},
    "pilot_id": {"type": "string", "pattern": "^fpl-[0-9a-f]{24}$"},
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_id": {"type": "string", "pattern": "^fpf-[0-9a-f]{24}$"},
    "preflight_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_id": {"type": "string", "pattern": "^fpa-[0-9a-f]{24}$"},
    "authorization_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_status": {"enum": ["completed", "failed", "aborted", "rolled_back"]},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "ended_at_utc": {"type": "string", "format": "date-time"},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "duration_minutes": {"type": "number", "exclusiveMinimum": 0},
    "evidence_files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_sequence", "evidence_role", "relative_path", "size_bytes", "sha256"],
        "properties": {
          "evidence_sequence": {"type": "integer", "minimum": 1},
          "evidence_role": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "single_use_authorization": {"const": true},
    "authorization_consumed": {"const": true},
    "execution_authorized": {"const": true},
    "execution_performed": {"const": true},
    "manual_execution_confirmed": {"const": true},
    "automatic_execution_used": {"const": false},
    "schedule_activation_allowed": {"const": false},
    "deployment_authorized": {"const": false},
    "model_activation_authorized": {"const": false},
    "credential_values_recorded": {"const": false},
    "source_evidence_mutated": {"const": false},
    "receipt_contract_version": {"const": "controlled-fabric-pilot-run-receipt-v1"},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
