{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval_health_run_trend_v1",
  "type": "object",
  "required": [
    "trend_run_id",
    "trend_run_timestamp_utc",
    "scenario",
    "history_sequence",
    "interval_run_id",
    "interval_run_timestamp_utc",
    "source_area",
    "resource_id",
    "city",
    "requested_horizon_minutes",
    "model_name",
    "feature_contract_version",
    "target_coverage_level",
    "calibration_observation_count",
    "calibration_radius_mw",
    "evaluation_end_utc",
    "evaluation_observation_count",
    "empirical_coverage_pct",
    "average_interval_width_mw",
    "interval_contract_version",
    "nominal_coverage_pct",
    "coverage_shortfall_pct_points",
    "slice_run_sequence",
    "slice_run_count",
    "monitoring_window",
    "is_latest_interval_run",
    "previous_interval_run_id",
    "previous_interval_run_timestamp_utc",
    "previous_empirical_coverage_pct",
    "previous_average_interval_width_mw",
    "previous_calibration_observation_count",
    "coverage_change_from_previous_pct_points",
    "interval_width_change_from_previous_pct",
    "calibration_history_change_from_previous_pct",
    "monitor_run_id",
    "monitor_status",
    "failed_error_check_count",
    "failed_warning_check_count",
    "trend_contract_version"
  ],
  "properties": {
    "trend_run_id": {"type": "string", "pattern": "^iht-[0-9a-f]{24}$"},
    "trend_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "scenario": {"enum": ["healthy", "warning", "failed"]},
    "history_sequence": {"type": "integer", "minimum": 1},
    "interval_run_id": {"type": "string", "minLength": 1},
    "interval_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "requested_horizon_minutes": {"type": "integer", "minimum": 1},
    "model_name": {"type": "string", "minLength": 1},
    "feature_contract_version": {"type": "string", "minLength": 1},
    "target_coverage_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "calibration_observation_count": {"type": "integer", "minimum": 1},
    "calibration_radius_mw": {"type": "number", "minimum": 0},
    "evaluation_end_utc": {"type": "string", "format": "date-time"},
    "evaluation_observation_count": {"type": "integer", "minimum": 1},
    "empirical_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "average_interval_width_mw": {"type": "number", "minimum": 0},
    "interval_contract_version": {"type": "string", "minLength": 1},
    "nominal_coverage_pct": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100},
    "coverage_shortfall_pct_points": {"type": "number", "minimum": 0, "maximum": 100},
    "slice_run_sequence": {"type": "integer", "minimum": 1},
    "slice_run_count": {"type": "integer", "minimum": 1},
    "monitoring_window": {"enum": ["older", "reference", "recent"]},
    "is_latest_interval_run": {"type": "boolean"},
    "previous_interval_run_id": {"type": ["string", "null"]},
    "previous_interval_run_timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "previous_empirical_coverage_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "previous_average_interval_width_mw": {"type": ["number", "null"], "minimum": 0},
    "previous_calibration_observation_count": {"type": ["number", "null"], "minimum": 1},
    "coverage_change_from_previous_pct_points": {"type": ["number", "null"]},
    "interval_width_change_from_previous_pct": {"type": ["number", "null"]},
    "calibration_history_change_from_previous_pct": {"type": ["number", "null"]},
    "monitor_run_id": {"type": "string", "minLength": 1},
    "monitor_status": {"enum": ["healthy", "warning", "failed"]},
    "failed_error_check_count": {"type": "integer", "minimum": 0},
    "failed_warning_check_count": {"type": "integer", "minimum": 0},
    "trend_contract_version": {"const": "interval-health-trend-v1"}
  },
  "additionalProperties": false
}
