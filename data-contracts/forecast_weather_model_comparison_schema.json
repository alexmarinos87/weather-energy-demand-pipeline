{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "forecast_weather_model_comparison_prediction_v1",
  "description": "Paired prediction evidence comparing observed-at-feature and target-valid forecast weather.",
  "type": "object",
  "required": [
    "run_id",
    "run_timestamp_utc",
    "source_area",
    "resource_id",
    "city",
    "feature_timestamp_utc",
    "event_timestamp_utc",
    "requested_horizon_minutes",
    "split",
    "model_name",
    "weather_feature_mode",
    "actual_demand_mw",
    "predicted_demand_mw",
    "absolute_error_mw",
    "squared_error_mw2",
    "trained_through_utc",
    "feature_contract_version",
    "forecast_weather_contract_version",
    "weather_comparison_contract_version",
    "forecast_weather_eligible_count",
    "forecast_weather_matched_count",
    "forecast_weather_coverage_pct",
    "minimum_forecast_weather_coverage_pct",
    "target_weather_forecast_issued_at_utc",
    "target_weather_forecast_ingested_at_utc",
    "target_weather_forecast_valid_at_utc",
    "target_weather_temperature_c",
    "target_weather_humidity_pct",
    "target_weather_provider",
    "target_weather_model",
    "target_weather_valid_delta_minutes",
    "target_weather_feature_lead_minutes",
    "target_weather_availability_age_minutes",
    "training_observation_count",
    "evaluation_contract_version"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "run_timestamp_utc": {"type": "string", "format": "date-time"},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "feature_timestamp_utc": {"type": "string", "format": "date-time"},
    "event_timestamp_utc": {"type": "string", "format": "date-time"},
    "requested_horizon_minutes": {"type": "integer", "enum": [30, 60]},
    "split": {"type": "string", "enum": ["validation", "test"]},
    "model_name": {
      "type": "string",
      "enum": ["ridge_weather_lag", "ridge_target_weather"]
    },
    "weather_feature_mode": {
      "type": "string",
      "enum": ["observed_at_feature", "target_forecast"]
    },
    "actual_demand_mw": {"type": "number"},
    "predicted_demand_mw": {"type": "number"},
    "absolute_error_mw": {"type": "number", "minimum": 0},
    "squared_error_mw2": {"type": "number", "minimum": 0},
    "trained_through_utc": {"type": "string", "format": "date-time"},
    "feature_contract_version": {"type": "string", "const": "time-horizon-v1"},
    "forecast_weather_contract_version": {
      "type": "string",
      "const": "target-weather-v1"
    },
    "weather_comparison_contract_version": {
      "type": "string",
      "const": "weather-model-comparison-v1"
    },
    "forecast_weather_eligible_count": {"type": "integer", "minimum": 1},
    "forecast_weather_matched_count": {"type": "integer", "minimum": 1},
    "forecast_weather_coverage_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "minimum_forecast_weather_coverage_pct": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "target_weather_forecast_issued_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "target_weather_forecast_ingested_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "target_weather_forecast_valid_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "target_weather_temperature_c": {"type": "number"},
    "target_weather_humidity_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "target_weather_provider": {"type": "string", "minLength": 1},
    "target_weather_model": {"type": "string", "minLength": 1},
    "target_weather_valid_delta_minutes": {"type": "number", "minimum": 0},
    "target_weather_feature_lead_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "target_weather_availability_age_minutes": {
      "type": "number",
      "minimum": 0
    },
    "training_observation_count": {"type": "integer", "minimum": 1},
    "evaluation_contract_version": {
      "type": "string",
      "enum": ["fixed-holdout-v1", "rolling-origin-v1"]
    },
    "origin_fold": {"type": ["integer", "null"], "minimum": 1},
    "origin_count": {"type": ["integer", "null"], "minimum": 2},
    "origin_cutoff_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"model_name": {"const": "ridge_weather_lag"}}},
      "then": {
        "properties": {
          "weather_feature_mode": {"const": "observed_at_feature"}
        }
      }
    },
    {
      "if": {"properties": {"model_name": {"const": "ridge_target_weather"}}},
      "then": {
        "properties": {
          "weather_feature_mode": {"const": "target_forecast"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation_contract_version": {"const": "rolling-origin-v1"}
        }
      },
      "then": {
        "required": ["origin_fold", "origin_count", "origin_cutoff_utc"]
      }
    }
  ],
  "additionalProperties": true
}
