{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval_policy_sensitivity_slice_v1",
  "type": "object",
  "required": [
    "sensitivity_run_id",
    "sensitivity_run_timestamp_utc",
    "trend_run_id",
    "scenario",
    "source_area",
    "resource_id",
    "city",
    "requested_horizon_minutes",
    "model_name",
    "feature_contract_version",
    "target_coverage_level",
    "interval_contract_version",
    "candidate_id",
    "candidate_role",
    "retained_monitor_status",
    "candidate_slice_status",
    "active_reference_slice_status",
    "status_changed_from_active_slice",
    "sensitivity_contract_version",
    "active_policy_updated",
    "candidate_thresholds_activated",
    "retained_evidence_mutated",
    "interval_recalibration_performed",
    "model_change_performed",
    "schedule_change_performed",
    "promotion_change_performed",
    "alert_delivery_performed"
  ],
  "properties": {
    "sensitivity_run_id": {"type": "string", "pattern": "^ips-[0-9a-f]{24}$"},
    "sensitivity_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "trend_run_id": {"type": "string", "pattern": "^iht-[0-9a-f]{24}$"},
    "scenario": {"type": "string", "minLength": 1},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "requested_horizon_minutes": {"type": "integer", "minimum": 1},
    "model_name": {"type": "string", "minLength": 1},
    "feature_contract_version": {"type": "string", "minLength": 1},
    "target_coverage_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "interval_contract_version": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_role": {"enum": ["active_reference", "review_candidate"]},
    "retained_monitor_status": {"enum": ["healthy", "warning", "failed"]},
    "candidate_slice_status": {"enum": ["healthy", "warning", "failed"]},
    "active_reference_slice_status": {"enum": ["healthy", "warning", "failed"]},
    "status_changed_from_active_slice": {"type": "boolean"},
    "coverage_drop_passed": {"type": ["boolean", "null"]},
    "interval_width_increase_passed": {"type": ["boolean", "null"]},
    "calibration_history_drop_passed": {"type": ["boolean", "null"]},
    "sensitivity_contract_version": {"const": "interval-policy-sensitivity-v1"},
    "active_policy_updated": {"const": false},
    "candidate_thresholds_activated": {"const": false},
    "retained_evidence_mutated": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "schedule_change_performed": {"const": false},
    "promotion_change_performed": {"const": false},
    "alert_delivery_performed": {"const": false}
  },
  "additionalProperties": true
}
