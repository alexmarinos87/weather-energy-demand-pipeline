{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval_policy_sensitivity_slice_v1",
  "type": "object",
  "required": [
    "sensitivity_run_id", "sensitivity_run_timestamp_utc", "sensitivity_as_of_utc",
    "trend_run_id", "policy_id", "policy_role", "policy_version", "scenario",
    "source_area", "resource_id", "city", "requested_horizon_minutes", "model_name",
    "feature_contract_version", "target_coverage_level", "interval_contract_version",
    "retained_monitor_status", "candidate_slice_status",
    "candidate_error_failure_count", "candidate_warning_failure_count",
    "active_policy_updated", "retained_evidence_mutated", "interval_recalibration_performed",
    "model_change_performed", "schedule_change_performed", "promotion_change_performed",
    "alert_delivery_performed", "sensitivity_contract_version"
  ],
  "properties": {
    "sensitivity_run_id": {"type": "string", "pattern": "^ips-[0-9a-f]{24}$"},
    "sensitivity_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "sensitivity_as_of_utc": {"type": "string", "format": "date-time"},
    "trend_run_id": {"type": "string", "pattern": "^iht-[0-9a-f]{24}$"},
    "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "policy_role": {"enum": ["active_reference", "review_candidate"]},
    "policy_version": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "requested_horizon_minutes": {"type": "integer", "minimum": 1},
    "model_name": {"type": "string", "minLength": 1},
    "feature_contract_version": {"type": "string", "minLength": 1},
    "target_coverage_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "interval_contract_version": {"type": "string", "minLength": 1},
    "retained_monitor_status": {"enum": ["healthy", "warning", "failed"]},
    "candidate_slice_status": {"enum": ["healthy", "warning", "failed"]},
    "candidate_error_failure_count": {"type": "integer", "minimum": 0},
    "candidate_warning_failure_count": {"type": "integer", "minimum": 0},
    "active_policy_updated": {"const": false},
    "retained_evidence_mutated": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "schedule_change_performed": {"const": false},
    "promotion_change_performed": {"const": false},
    "alert_delivery_performed": {"const": false},
    "sensitivity_contract_version": {"const": "interval-policy-sensitivity-v1"}
  },
  "additionalProperties": true
}
