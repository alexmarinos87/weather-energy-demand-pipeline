{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval_policy_compatibility_slice_v1",
  "type": "object",
  "required": [
    "compatibility_run_id",
    "compatibility_timestamp_utc",
    "source_health_checks_sha256",
    "source_monitor_run_id",
    "source_area",
    "resource_id",
    "city",
    "requested_horizon_minutes",
    "model_name",
    "feature_contract_version",
    "target_coverage_level",
    "interval_contract_version",
    "previous_policy_status",
    "current_policy_status",
    "status_changed",
    "compatibility_contract_version"
  ],
  "properties": {
    "compatibility_run_id": {"type": "string", "minLength": 1},
    "compatibility_timestamp_utc": {"type": "string", "format": "date-time"},
    "source_health_checks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_monitor_run_id": {"type": "string", "minLength": 1},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "requested_horizon_minutes": {"type": "integer", "minimum": 1},
    "model_name": {"type": "string", "minLength": 1},
    "feature_contract_version": {"type": "string", "minLength": 1},
    "target_coverage_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "interval_contract_version": {"type": "string", "minLength": 1},
    "previous_policy_status": {"enum": ["healthy", "warning", "failed"]},
    "current_policy_status": {"enum": ["healthy", "warning", "failed"]},
    "status_changed": {"type": "boolean"},
    "compatibility_contract_version": {"const": "interval-policy-compatibility-v1"}
  },
  "additionalProperties": true
}
