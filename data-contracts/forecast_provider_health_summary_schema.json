{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "forecast_provider_health_summary_v1",
  "type": "object",
  "required": [
    "monitor_run_id",
    "monitor_timestamp_utc",
    "monitor_as_of_utc",
    "monitor_status",
    "automatic_remediation_allowed",
    "check_count",
    "passed_check_count",
    "failed_error_check_count",
    "failed_warning_check_count",
    "monitored_forecast_identity_count",
    "monitored_reconciliation_slice_count",
    "policy_version",
    "monitoring_contract_version"
  ],
  "properties": {
    "monitor_run_id": {"type": "string", "minLength": 1},
    "monitor_timestamp_utc": {"type": "string", "format": "date-time"},
    "monitor_as_of_utc": {"type": "string", "format": "date-time"},
    "monitor_status": {"enum": ["healthy", "warning", "failed"]},
    "automatic_remediation_allowed": {"const": false},
    "check_count": {"type": "integer", "minimum": 1},
    "passed_check_count": {"type": "integer", "minimum": 0},
    "failed_error_check_count": {"type": "integer", "minimum": 0},
    "failed_warning_check_count": {"type": "integer", "minimum": 0},
    "monitored_forecast_identity_count": {"type": "integer", "minimum": 1},
    "monitored_reconciliation_slice_count": {"type": "integer", "minimum": 1},
    "policy_version": {"const": "forecast-provider-health-policy-v1"},
    "monitoring_contract_version": {"const": "forecast-provider-monitoring-v1"}
  },
  "additionalProperties": true
}
