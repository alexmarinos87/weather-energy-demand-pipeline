{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "forecast_weather_quality_metrics_v1",
  "type": "object",
  "required": [
    "reconciliation_run_id",
    "reconciliation_run_timestamp_utc",
    "source_area",
    "city",
    "forecast_provider",
    "forecast_model",
    "forecast_lead_time_bucket",
    "eligible_forecast_count",
    "matched_forecast_count",
    "forecast_observation_coverage_pct",
    "minimum_forecast_observation_coverage_pct",
    "observation_tolerance_minutes",
    "forecast_provider_lead_minutes_avg",
    "forecast_pipeline_lead_minutes_avg",
    "forecast_valid_start_utc",
    "forecast_valid_end_utc",
    "reconciliation_contract_version"
  ],
  "properties": {
    "reconciliation_run_id": {"type": "string", "minLength": 1},
    "reconciliation_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "source_area": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "forecast_provider": {"type": "string", "minLength": 1},
    "forecast_model": {"type": "string", "minLength": 1},
    "forecast_issue_basis": {"type": ["string", "null"]},
    "forecast_lead_time_bucket": {
      "enum": ["00-06h", "06-12h", "12-24h", "24-48h", "48h+"]
    },
    "eligible_forecast_count": {"type": "integer", "minimum": 1},
    "matched_forecast_count": {"type": "integer", "minimum": 0},
    "forecast_observation_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "minimum_forecast_observation_coverage_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
    "observation_tolerance_minutes": {"type": "integer", "minimum": 0},
    "forecast_provider_lead_minutes_avg": {"type": "number", "exclusiveMinimum": 0},
    "forecast_pipeline_lead_minutes_avg": {"type": "number", "exclusiveMinimum": 0},
    "temperature_mae_c": {"type": ["number", "null"], "minimum": 0},
    "temperature_rmse_c": {"type": ["number", "null"], "minimum": 0},
    "temperature_bias_c": {"type": ["number", "null"]},
    "humidity_mae_pct": {"type": ["number", "null"], "minimum": 0},
    "humidity_rmse_pct": {"type": ["number", "null"], "minimum": 0},
    "humidity_bias_pct": {"type": ["number", "null"]},
    "observation_valid_time_delta_minutes_avg": {"type": ["number", "null"]},
    "observation_absolute_valid_time_delta_minutes_avg": {"type": ["number", "null"], "minimum": 0},
    "observation_absolute_valid_time_delta_minutes_max": {"type": ["number", "null"], "minimum": 0},
    "observation_ingestion_lag_minutes_avg": {"type": ["number", "null"], "minimum": 0},
    "observation_ingestion_lag_minutes_max": {"type": ["number", "null"], "minimum": 0},
    "forecast_valid_start_utc": {"type": "string", "format": "date-time"},
    "forecast_valid_end_utc": {"type": "string", "format": "date-time"},
    "reconciliation_contract_version": {"const": "forecast-observation-reconciliation-v1"}
  },
  "additionalProperties": true
}
