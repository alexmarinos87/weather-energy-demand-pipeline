{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": "evidence-retention-policy-v1",
  "description": "Dry-run-first local evidence lifecycle policy. Non-retain actions are recommendations only until a separate explicit apply workflow is used.",
  "excluded_prefixes": [
    "lifecycle/",
    "quarantine/"
  ],
  "protected_candidate_states": [
    "review_requested",
    "approved"
  ],
  "unclassified_action": "retain",
  "categories": [
    {
      "category": "model_registry",
      "patterns": ["model-registry/**"],
      "retention_days": null,
      "min_keep_latest": 0,
      "compact_after_days": null,
      "compaction_formats": [],
      "min_compaction_files": 0,
      "max_compaction_source_bytes": 0,
      "always_protect": true
    },
    {
      "category": "raw_forecast_weather",
      "patterns": ["raw/forecast_weather/**"],
      "retention_days": 90,
      "min_keep_latest": 20,
      "compact_after_days": null,
      "compaction_formats": [],
      "min_compaction_files": 0,
      "max_compaction_source_bytes": 0,
      "always_protect": false
