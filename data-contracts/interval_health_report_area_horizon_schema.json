{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval_health_report_area_horizon_v1",
  "type": "object",
  "required": [
    "report_run_id",
    "report_run_timestamp_utc",
    "trend_run_id",
    "scenario",
    "monitor_status",
    "status_rank",
    "report_contract_version",
    "source_area",
    "resource_id",
    "city",
    "requested_horizon_minutes",
    "model_count",
    "coverage_level_count",
    "slice_count",
    "attention_slice_count",
    "maximum_latest_coverage_shortfall_pct_points",
    "maximum_average_interval_width_increase_pct",
    "maximum_coverage_drop_pct_points",
    "minimum_recent_calibration_observation_count"
  ],
  "properties": {
    "report_run_id": {"type": "string", "pattern": "^ihr-[0-9a-f]{24}$"},
    "report_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "trend_run_id": {"type": "string", "pattern": "^iht-[0-9a-f]{24}$"},
    "scenario": {"enum": ["healthy", "warning", "failed"]},
    "monitor_status": {"enum": ["healthy", "warning", "failed"]},
    "status_rank": {"type": "integer", "minimum": 0, "maximum": 2},
    "report_contract_version": {"const": "interval-health-report-v1"},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "requested_horizon_minutes": {"type": "integer", "minimum": 1},
    "model_count": {"type": "integer", "minimum": 1},
    "coverage_level_count": {"type": "integer", "minimum": 1},
    "slice_count": {"type": "integer", "minimum": 1},
    "attention_slice_count": {"type": "integer", "minimum": 0},
    "maximum_latest_coverage_shortfall_pct_points": {"type": "number", "minimum": 0, "maximum": 100},
    "maximum_average_interval_width_increase_pct": {"type": ["number", "null"]},
    "maximum_coverage_drop_pct_points": {"type": ["number", "null"]},
    "minimum_recent_calibration_observation_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
