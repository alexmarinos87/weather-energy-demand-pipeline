{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence_restore_event_v1",
  "type": "object",
  "required": [
    "restore_id",
    "operation_id",
    "plan_id",
    "restored_at_utc",
    "actor",
    "reason",
    "file_count",
    "total_bytes",
    "quarantine_manifest_hash",
    "permanent_deletion_performed",
    "restore_event_contract_version",
    "restore_event_hash"
  ],
  "properties": {
    "restore_id": {"type": "string", "pattern": "^rst-[0-9a-f]{24}$"},
    "operation_id": {"type": "string", "pattern": "^qtn-[0-9a-f]{24}$"},
    "plan_id": {"type": "string", "pattern": "^elp-[0-9a-f]{24}$"},
    "restored_at_utc": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "file_count": {"type": "integer", "minimum": 1},
    "total_bytes": {"type": "integer", "minimum": 0},
    "quarantine_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "permanent_deletion_performed": {"const": false},
    "restore_event_contract_version": {"const": "evidence-restore-event-v1"},
    "restore_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
