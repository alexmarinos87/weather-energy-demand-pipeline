{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval_policy_review_decision_v1",
  "type": "object",
  "required": [
    "decision_id", "decision_revision", "sensitivity_run_id",
    "sensitivity_run_timestamp_utc", "trend_run_id",
    "sensitivity_summary_sha256", "active_policy_id",
    "active_policy_version", "target_policy_id", "target_policy_role",
    "target_policy_version", "decision", "decision_effect",
    "reviewer_name", "reviewer_role", "review_ticket", "rationale",
    "requested_revision", "decided_at_utc", "scenario_evidence",
    "human_decision_confirmed", "follow_up_human_action_required",
    "threshold_activation_authorized", "candidate_thresholds_activated",
    "active_policy_updated", "retained_evidence_mutated",
    "interval_recalibration_performed", "model_change_performed",
    "schedule_change_performed", "promotion_change_performed",
    "alert_delivery_performed", "deployment_performed",
    "external_publication_performed", "decision_contract_version",
    "decision_hash"
  ],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^ipd-[0-9a-f]{24}$"},
    "decision_revision": {"const": 1},
    "sensitivity_run_id": {"type": "string", "minLength": 1},
    "sensitivity_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "trend_run_id": {"type": "string", "minLength": 1},
    "sensitivity_summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "active_policy_id": {"const": "active-reference"},
    "active_policy_version": {"type": "string", "minLength": 1},
    "target_policy_id": {"type": "string", "minLength": 1},
    "target_policy_role": {"enum": ["active_reference", "review_candidate"]},
    "target_policy_version": {"type": "string", "minLength": 1},
    "decision": {"enum": ["retain_active_policy", "reject_candidate", "request_revision"]},
    "decision_effect": {"enum": ["active_policy_retained_for_review", "review_candidate_rejected", "review_candidate_revision_requested"]},
    "reviewer_name": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "review_ticket": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "requested_revision": {"type": ["string", "null"]},
    "decided_at_utc": {"type": "string", "format": "date-time"},
    "scenario_evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario", "retained_monitor_status", "active_reference_status", "target_candidate_status", "sensitivity_classification", "status_changed_from_active", "changed_slice_count", "human_review_required"],
        "properties": {
          "scenario": {"type": "string", "minLength": 1},
          "retained_monitor_status": {"enum": ["healthy", "warning", "failed"]},
          "active_reference_status": {"enum": ["healthy", "warning", "failed"]},
          "target_candidate_status": {"enum": ["healthy", "warning", "failed"]},
          "sensitivity_classification": {"enum": ["active_reference", "status_robust", "status_sensitive"]},
          "status_changed_from_active": {"type": "boolean"},
          "changed_slice_count": {"type": "integer", "minimum": 0},
          "human_review_required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "human_decision_confirmed": {"const": true},
    "follow_up_human_action_required": {"const": true},
    "threshold_activation_authorized": {"const": false},
    "candidate_thresholds_activated": {"const": false},
    "active_policy_updated": {"const": false},
    "retained_evidence_mutated": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "schedule_change_performed": {"const": false},
    "promotion_change_performed": {"const": false},
    "alert_delivery_performed": {"const": false},
    "deployment_performed": {"const": false},
    "external_publication_performed": {"const": false},
    "decision_contract_version": {"const": "interval-policy-review-decision-v1"},
    "decision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
