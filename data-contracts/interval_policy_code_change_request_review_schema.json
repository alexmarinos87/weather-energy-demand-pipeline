{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval-policy-code-change-request-review-v1",
  "type": "object",
  "required": [
    "code_change_request_review_id",
    "code_change_request_review_revision",
    "source_code_change_request_id",
    "source_code_change_request_sha256",
    "source_implementation_dry_run_review_id",
    "source_implementation_dry_run_review_sha256",
    "source_implementation_dry_run_id",
    "source_implementation_dry_run_sha256",
    "current_repository_commit",
    "current_repository_tree",
    "policy_source_path",
    "current_policy_source_sha256",
    "current_policy_source_git_blob_sha1",
    "active_policy_sha256",
    "proposed_policy_sha256",
    "revised_candidate_id",
    "revised_candidate_version",
    "changed_threshold_fields",
    "changed_threshold_count",
    "changed_threshold_digest",
    "reviewed_patch_sha256",
    "intended_paths",
    "validation_commands",
    "requested_branch_name",
    "requested_pr_title",
    "review_decision",
    "review_effect",
    "requested_updates",
    "reviewer_name",
    "reviewer_role",
    "review_ticket",
    "rationale",
    "reviewed_at_utc",
    "named_human_review_confirmed",
    "follow_up_human_action_required",
    "next_action",
    "policy_defaults_pr_authorized",
    "policy_defaults_pr_created",
    "code_change_authorized",
    "code_change_created",
    "branch_created",
    "pull_request_created",
    "implementation_authorized",
    "implementation_applied",
    "patch_applied",
    "source_file_mutated",
    "threshold_activation_authorized",
    "active_policy_updated",
    "candidate_thresholds_activated",
    "source_request_mutated",
    "source_review_mutated",
    "source_proposal_mutated",
    "retained_evidence_mutated",
    "interval_recalibration_performed",
    "model_change_performed",
    "schedule_change_performed",
    "promotion_change_performed",
    "alert_delivery_performed",
    "deployment_performed",
    "external_publication_performed",
    "code_change_request_review_contract_version",
    "code_change_request_review_sha256"
  ],
  "properties": {
    "code_change_request_review_id": {"type": "string", "pattern": "^ipccrr-[0-9a-f]{24}$"},
    "code_change_request_review_revision": {"const": 1},
    "source_code_change_request_id": {"type": "string", "pattern": "^ipccr-[0-9a-f]{24}$"},
    "source_code_change_request_sha256": {"$ref": "#/$defs/sha256"},
    "source_implementation_dry_run_review_id": {"type": "string", "minLength": 1},
    "source_implementation_dry_run_review_sha256": {"$ref": "#/$defs/sha256"},
    "source_implementation_dry_run_id": {"type": "string", "minLength": 1},
    "source_implementation_dry_run_sha256": {"$ref": "#/$defs/sha256"},
    "current_repository_commit": {"$ref": "#/$defs/sha1"},
    "current_repository_tree": {"$ref": "#/$defs/sha1"},
    "policy_source_path": {"const": "forecasting/interval_monitoring.py"},
    "current_policy_source_sha256": {"$ref": "#/$defs/sha256"},
    "current_policy_source_git_blob_sha1": {"$ref": "#/$defs/sha1"},
    "active_policy_sha256": {"$ref": "#/$defs/sha256"},
    "proposed_policy_sha256": {"$ref": "#/$defs/sha256"},
    "revised_candidate_id": {"type": "string", "minLength": 1},
    "revised_candidate_version": {"type": "string", "minLength": 1},
    "changed_threshold_fields": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "changed_threshold_count": {"type": "integer", "minimum": 1},
    "changed_threshold_digest": {"$ref": "#/$defs/sha256"},
    "reviewed_patch_sha256": {"$ref": "#/$defs/sha256"},
    "intended_paths": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "validation_commands": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "requested_branch_name": {"type": "string", "minLength": 3},
    "requested_pr_title": {"type": "string", "minLength": 10},
    "review_decision": {
      "enum": [
        "accept_for_separate_policy_defaults_pr",
        "reject_code_change_request",
        "request_code_change_request_revision"
      ]
    },
    "review_effect": {
      "enum": [
        "separate_policy_defaults_pr_required",
        "no_further_action_recorded",
        "revised_code_change_request_required"
      ]
    },
    "requested_updates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 10}},
    "reviewer_name": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "review_ticket": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 30},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "named_human_review_confirmed": {"const": true},
    "follow_up_human_action_required": {"type": "boolean"},
    "next_action": {
      "enum": [
        "separate_policy_defaults_pr_required",
        "no_further_action_recorded",
        "revised_code_change_request_required"
      ]
    },
    "policy_defaults_pr_authorized": {"const": false},
    "policy_defaults_pr_created": {"const": false},
    "code_change_authorized": {"const": false},
    "code_change_created": {"const": false},
    "branch_created": {"const": false},
    "pull_request_created": {"const": false},
    "implementation_authorized": {"const": false},
    "implementation_applied": {"const": false},
    "patch_applied": {"const": false},
    "source_file_mutated": {"const": false},
    "threshold_activation_authorized": {"const": false},
    "active_policy_updated": {"const": false},
    "candidate_thresholds_activated": {"const": false},
    "source_request_mutated": {"const": false},
    "source_review_mutated": {"const": false},
    "source_proposal_mutated": {"const": false},
    "retained_evidence_mutated": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "schedule_change_performed": {"const": false},
    "promotion_change_performed": {"const": false},
    "alert_delivery_performed": {"const": false},
    "deployment_performed": {"const": false},
    "external_publication_performed": {"const": false},
    "code_change_request_review_contract_version": {"const": "interval-policy-code-change-request-review-v1"},
    "code_change_request_review_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
