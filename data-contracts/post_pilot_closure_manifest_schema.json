{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "post_pilot_closure_manifest_v1",
  "type": "object",
  "required": [
    "closure_id",
    "closure_revision",
    "closure_state",
    "pilot_id",
    "plan_hash",
    "candidate_id",
    "candidate_version",
    "authorization_id",
    "authorization_hash",
    "receipt_id",
    "receipt_hash",
    "assessment_id",
    "assessment_hash",
    "decision_id",
    "decision_hash",
    "decision",
    "external_run_id",
    "created_by",
    "review_ticket",
    "reason",
    "created_at_utc",
    "items",
    "item_count",
    "total_size_bytes",
    "active_model_unchanged",
    "model_registry_mutation_allowed",
    "authorization_reuse_allowed",
    "schedule_activation_allowed",
    "deployment_authorized",
    "model_activation_authorized",
    "source_evidence_mutated",
    "permanent_deletion_allowed",
    "closure_manifest_contract_version",
    "manifest_hash"
  ],
  "properties": {
    "closure_id": {"type": "string", "pattern": "^pcl-[0-9a-f]{24}$"},
    "closure_revision": {"const": 1},
    "closure_state": {"const": "closed"},
    "pilot_id": {"type": "string", "pattern": "^fpl-[0-9a-f]{24}$"},
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "authorization_id": {"type": "string", "pattern": "^fpa-[0-9a-f]{24}$"},
    "authorization_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_id": {"type": "string", "pattern": "^fpr-[0-9a-f]{24}$"},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assessment_id": {"type": "string", "pattern": "^fra-[0-9a-f]{24}$"},
    "assessment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_id": {"type": "string", "pattern": "^fpd-[0-9a-f]{24}$"},
    "decision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {
      "enum": [
        "continue_evidence_collection",
        "revise_candidate",
        "retire_candidate"
      ]
    },
    "external_run_id": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "review_ticket": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 20},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "item_sequence",
          "item_role",
          "archive_path",
          "source_relative_path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "item_sequence": {"type": "integer", "minimum": 1},
          "item_role": {"type": "string", "minLength": 1},
          "archive_path": {"type": "string", "minLength": 1},
          "source_relative_path": {"type": ["string", "null"]},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "item_count": {"type": "integer", "minimum": 7},
    "total_size_bytes": {"type": "integer", "minimum": 0},
    "active_model_unchanged": {"const": true},
    "model_registry_mutation_allowed": {"const": false},
    "authorization_reuse_allowed": {"const": false},
    "schedule_activation_allowed": {"const": false},
    "deployment_authorized": {"const": false},
    "model_activation_authorized": {"const": false},
    "source_evidence_mutated": {"const": false},
    "permanent_deletion_allowed": {"const": false},
    "closure_manifest_contract_version": {"const": "post-pilot-closure-manifest-v1"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
