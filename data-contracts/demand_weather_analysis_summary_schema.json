{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "demand_weather_analysis_summary_v1",
  "type": "object",
  "required": [
    "analysis_run_id",
    "analysis_timestamp_utc",
    "source_area",
    "resource_id",
    "city",
    "observation_count",
    "observation_start_utc",
    "observation_end_utc",
    "median_interval_minutes",
    "demand_mean_mw",
    "demand_min_mw",
    "demand_max_mw",
    "demand_p95_mw",
    "temperature_mean_c",
    "temperature_min_c",
    "temperature_max_c",
    "humidity_mean_pct",
    "weather_age_mean_minutes",
    "weather_age_max_minutes",
    "demand_temperature_pearson",
    "demand_humidity_pearson",
    "analysis_contract_version"
  ],
  "properties": {
    "analysis_run_id": {"type": "string", "pattern": "^dwa-[0-9a-f]{24}$"},
    "analysis_timestamp_utc": {"type": "string", "format": "date-time"},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "observation_count": {"type": "integer", "minimum": 2},
    "observation_start_utc": {"type": "string", "format": "date-time"},
    "observation_end_utc": {"type": "string", "format": "date-time"},
    "median_interval_minutes": {"type": "number", "exclusiveMinimum": 0},
    "demand_mean_mw": {"type": "number"},
    "demand_min_mw": {"type": "number"},
    "demand_max_mw": {"type": "number"},
    "demand_p95_mw": {"type": "number"},
    "temperature_mean_c": {"type": "number"},
    "temperature_min_c": {"type": "number"},
    "temperature_max_c": {"type": "number"},
    "humidity_mean_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "weather_age_mean_minutes": {"type": "number", "minimum": 0},
    "weather_age_max_minutes": {"type": "number", "minimum": 0},
    "demand_temperature_pearson": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "demand_humidity_pearson": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "analysis_contract_version": {"const": "demand-weather-analytics-v1"}
  },
  "additionalProperties": true
}
