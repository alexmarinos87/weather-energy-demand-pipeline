{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "operator_supplied_fabric_pilot_run_report_v1",
  "type": "object",
  "required": [
    "external_run_id", "operator", "run_status", "started_at_utc", "ended_at_utc",
    "environment", "workspace_name", "lakehouse_name", "capacity_name", "repository",
    "code_commit_sha", "code_tree_sha", "executed_notebook_paths", "written_tables",
    "credential_references_used", "forecast_record_count", "prediction_row_count",
    "metric_row_count", "failed_quality_check_count", "notebook_retry_count",
    "peak_capacity_units", "schedule_created", "deployment_performed",
    "model_activation_performed", "active_model_before", "active_model_after",
    "rollback_performed", "rollback_reason", "credential_values_included"
  ],
  "properties": {
    "external_run_id": {"type": "string", "minLength": 1},
    "operator": {"type": "string", "minLength": 1},
    "run_status": {"enum": ["completed", "failed", "aborted", "rolled_back"]},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "ended_at_utc": {"type": "string", "format": "date-time"},
    "environment": {"enum": ["sandbox", "development", "test", "non-production"]},
    "workspace_name": {"type": "string", "minLength": 1},
    "lakehouse_name": {"type": "string", "minLength": 1},
    "capacity_name": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "code_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "code_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "executed_notebook_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "written_tables": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "credential_references_used": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}},
    "forecast_record_count": {"type": "integer", "minimum": 0},
    "prediction_row_count": {"type": "integer", "minimum": 0},
    "metric_row_count": {"type": "integer", "minimum": 0},
    "failed_quality_check_count": {"type": "integer", "minimum": 0},
    "notebook_retry_count": {"type": "integer", "minimum": 0},
    "peak_capacity_units": {"type": "number", "minimum": 0},
    "schedule_created": {"const": false},
    "deployment_performed": {"const": false},
    "model_activation_performed": {"const": false},
    "active_model_before": {"const": "ridge_weather_lag"},
    "active_model_after": {"const": "ridge_weather_lag"},
    "rollback_performed": {"type": "boolean"},
    "rollback_reason": {"type": ["string", "null"]},
    "credential_values_included": {"const": false}
  },
  "additionalProperties": true
}
