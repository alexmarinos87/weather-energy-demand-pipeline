{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "target_weather_model_candidate_manifest_v1",
  "type": "object",
  "required": [
    "candidate_id",
    "candidate_revision",
    "candidate_state",
    "candidate_version",
    "repository",
    "code_commit_sha",
    "code_tree_sha",
    "baseline_model",
    "candidate_model",
    "training_data_boundary_utc",
    "feature_contract_versions",
    "forecast_weather_contract_version",
    "promotion_assessment_id",
    "promotion_assessment_status",
    "promotion_failed_check_count",
    "comparison_run_id",
    "reconciliation_run_id",
    "provider_health_monitor_run_id",
    "provider_health_status",
    "provider_failed_error_check_count",
    "automatic_promotion_allowed",
    "automatic_remediation_allowed",
    "deployment_authorized",
    "active_model_unchanged",
    "created_at_utc",
    "updated_at_utc",
    "created_by",
    "registration_reason",
    "latest_event_hash",
    "previous_manifest_hash",
    "manifest_contract_version",
    "manifest_hash"
  ],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^twc-[0-9a-f]{24}$"},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "candidate_state": {
      "enum": ["draft", "review_requested", "approved", "rejected", "retired"]
    },
    "candidate_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "code_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "code_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseline_model": {"const": "ridge_weather_lag"},
    "candidate_model": {"const": "ridge_target_weather"},
    "training_data_boundary_utc": {"type": "string", "format": "date-time"},
    "feature_contract_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forecast_weather_contract_version": {"type": "string", "minLength": 1},
    "promotion_assessment_id": {"type": "string", "minLength": 1},
    "promotion_assessment_status": {
      "enum": ["blocked", "eligible_for_human_review"]
    },
    "promotion_failed_check_count": {"type": "integer", "minimum": 0},
    "comparison_run_id": {"type": "string", "minLength": 1},
    "reconciliation_run_id": {"type": "string", "minLength": 1},
    "promotion_policy_version": {"type": ["string", "null"]},
    "promotion_assessment_contract_version": {"type": ["string", "null"]},
    "provider_health_monitor_run_id": {"type": "string", "minLength": 1},
    "provider_health_status": {"enum": ["healthy", "warning", "failed"]},
    "provider_failed_error_check_count": {"type": "integer", "minimum": 0},
    "provider_failed_warning_check_count": {"type": "integer", "minimum": 0},
    "provider_health_policy_version": {"type": ["string", "null"]},
    "provider_health_contract_version": {"type": ["string", "null"]},
    "automatic_promotion_allowed": {"const": false},
    "automatic_remediation_allowed": {"const": false},
    "deployment_authorized": {"const": false},
    "active_model_unchanged": {"const": true},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "registration_reason": {"type": "string", "minLength": 1},
    "review_requested_by": {"type": ["string", "null"]},
    "review_requested_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "review_decision": {"type": ["string", "null"], "enum": [null, "approved", "rejected"]},
    "reviewed_by": {"type": ["string", "null"]},
    "reviewed_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "review_ticket": {"type": ["string", "null"]},
    "review_reason": {"type": ["string", "null"]},
    "retired_by": {"type": ["string", "null"]},
    "retired_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "retirement_reason": {"type": ["string", "null"]},
    "latest_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_manifest_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "manifest_contract_version": {"const": "target-weather-model-candidate-v1"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
