{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval-policy-retained-compatibility-v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "compatibility_contract_version": {"const": "interval-policy-retained-compatibility-v2"},
    "compatibility_run_id": {"type": "string", "pattern": "^ipca-[0-9a-f]{24}$"},
    "compatibility_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "trend_run_id": {"type": "string", "minLength": 1},
    "compatibility_summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "candidate_id": {"const": "previous-five-point"},
        "candidate_role": {"const": "review_candidate"},
        "max_recent_coverage_shortfall_pct_points": {"const": 5.0}
      },
      "required": ["candidate_id", "candidate_role", "candidate_version", "max_recent_coverage_shortfall_pct_points", "source_policy_version"]
    },
    "current_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "candidate_id": {"const": "reviewed-three-point"},
        "candidate_role": {"const": "active_reference"},
        "max_recent_coverage_shortfall_pct_points": {"const": 3.0}
      },
      "required": ["candidate_id", "candidate_role", "candidate_version", "max_recent_coverage_shortfall_pct_points", "source_policy_version"]
    },
    "artifacts": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "role": {"enum": ["slices", "summary", "report"]},
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "required": ["role", "filename", "sha256"]
      }
    },
    "historical_statuses_rewritten": {"const": false},
    "retained_evidence_mutated": {"const": false},
    "monitoring_rerun_performed": {"const": false},
    "threshold_activation_performed": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "fabric_execution_performed": {"const": false},
    "schedule_change_performed": {"const": false},
    "promotion_change_performed": {"const": false},
    "alert_delivery_performed": {"const": false},
    "deployment_performed": {"const": false},
    "external_publication_performed": {"const": false}
  },
  "required": [
    "compatibility_run_id", "compatibility_run_timestamp_utc", "trend_run_id",
    "compatibility_summary_sha256", "previous_policy", "current_policy", "artifacts",
    "compatibility_contract_version", "historical_statuses_rewritten", "retained_evidence_mutated",
    "monitoring_rerun_performed", "threshold_activation_performed", "interval_recalibration_performed",
    "model_change_performed", "fabric_execution_performed", "schedule_change_performed",
    "promotion_change_performed", "alert_delivery_performed", "deployment_performed",
    "external_publication_performed", "manifest_sha256"
  ]
}
