{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence_lifecycle_summary_v1",
  "type": "object",
  "required": [
    "plan_id",
    "plan_created_at_utc",
    "inventory_as_of_utc",
    "policy_contract_version",
    "policy_sha256",
    "inventory_file_count",
    "inventory_size_bytes",
    "inventory_size_gib",
    "retain_file_count",
    "compact_candidate_file_count",
    "compact_candidate_bytes",
    "quarantine_candidate_file_count",
    "estimated_reclaimable_bytes",
    "estimated_reclaimable_gib",
    "protected_file_count",
    "unclassified_file_count",
    "monthly_storage_cost_per_gib",
    "estimated_current_monthly_storage_cost",
    "estimated_reclaimable_monthly_storage_cost",
    "mutation_performed",
    "summary_contract_version"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^elp-[0-9a-f]{24}$"},
    "plan_created_at_utc": {"type": "string", "format": "date-time"},
    "inventory_as_of_utc": {"type": "string", "format": "date-time"},
    "policy_contract_version": {"const": "evidence-retention-policy-v1"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventory_file_count": {"type": "integer", "minimum": 1},
    "inventory_size_bytes": {"type": "integer", "minimum": 0},
    "inventory_size_gib": {"type": "number", "minimum": 0},
    "retain_file_count": {"type": "integer", "minimum": 0},
    "compact_candidate_file_count": {"type": "integer", "minimum": 0},
    "compact_candidate_bytes": {"type": "integer", "minimum": 0},
    "quarantine_candidate_file_count": {"type": "integer", "minimum": 0},
    "estimated_reclaimable_bytes": {"type": "integer", "minimum": 0},
    "estimated_reclaimable_gib": {"type": "number", "minimum": 0},
    "protected_file_count": {"type": "integer", "minimum": 0},
    "unclassified_file_count": {"type": "integer", "minimum": 0},
    "monthly_storage_cost_per_gib": {"type": "number", "minimum": 0},
    "estimated_current_monthly_storage_cost": {"type": "number", "minimum": 0},
    "estimated_reclaimable_monthly_storage_cost": {"type": "number", "minimum": 0},
    "mutation_performed": {"const": false},
    "summary_contract_version": {"const": "evidence-lifecycle-summary-v1"}
  },
  "additionalProperties": false
}
