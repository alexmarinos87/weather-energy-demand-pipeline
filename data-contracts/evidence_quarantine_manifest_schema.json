{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence_quarantine_manifest_v1",
  "type": "object",
  "required": [
    "operation_id",
    "plan_id",
    "applied_at_utc",
    "actor",
    "reason",
    "data_root_name",
    "quarantine_root_relative_path",
    "file_count",
    "total_bytes",
    "entries",
    "permanent_deletion_performed",
    "restore_available",
    "manifest_contract_version",
    "manifest_hash"
  ],
  "properties": {
    "operation_id": {"type": "string", "pattern": "^qtn-[0-9a-f]{24}$"},
    "plan_id": {"type": "string", "pattern": "^elp-[0-9a-f]{24}$"},
    "applied_at_utc": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "data_root_name": {"type": "string", "minLength": 1},
    "quarantine_root_relative_path": {"type": "string", "minLength": 1},
    "file_count": {"type": "integer", "minimum": 1},
    "total_bytes": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entry_sequence",
          "category",
          "source_relative_path",
          "quarantine_relative_path",
          "size_bytes",
          "sha256",
          "original_modified_at_utc"
        ],
        "properties": {
          "entry_sequence": {"type": "integer", "minimum": 1},
          "category": {"type": "string", "minLength": 1},
          "source_relative_path": {"type": "string", "minLength": 1},
          "quarantine_relative_path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "original_modified_at_utc": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "permanent_deletion_performed": {"const": false},
    "restore_available": {"const": true},
    "manifest_contract_version": {"const": "evidence-quarantine-manifest-v1"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
