{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "portfolio_demo_manifest_v2",
  "type": "object",
  "required": [
    "demo_run_id",
    "demo_run_timestamp_utc",
    "source_mode",
    "output_format",
    "source_area_contract_version",
    "source_groups",
    "source_bindings",
    "demand_horizons_minutes",
    "baseline_models",
    "comparison_models",
    "artifacts",
    "credential_free",
    "live_source_calls_performed",
    "fabric_operations_performed",
    "schedule_activation_performed",
    "model_promotion_performed",
    "external_publication_performed",
    "manifest_contract_version",
    "manifest_hash"
  ],
  "properties": {
    "demo_run_id": {"type": "string", "pattern": "^pdm-[0-9a-f]{24}$"},
    "demo_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "source_mode": {"const": "deterministic_credential_free_demo"},
    "output_format": {"enum": ["csv", "parquet"]},
    "source_area_contract_version": {"type": "string", "minLength": 1},
    "source_groups": {"const": 4},
    "source_bindings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["source_area", "resource_id", "city"],
        "properties": {
          "source_area": {
            "enum": [
              "east_midlands",
              "south_wales",
              "south_west",
              "west_midlands"
            ]
          },
          "resource_id": {"type": "string", "minLength": 1},
          "city": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "demand_horizons_minutes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": [30, 60]}
    },
    "baseline_models": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "comparison_models": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "artifact_role",
          "relative_path",
          "content_type",
          "size_bytes",
          "sha256",
          "row_count"
        ],
        "properties": {
          "artifact_role": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "content_type": {"enum": ["text/csv", "application/x-parquet", "text/markdown"]},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "row_count": {"type": ["integer", "null"], "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "credential_free": {"const": true},
    "live_source_calls_performed": {"const": false},
    "fabric_operations_performed": {"const": false},
    "schedule_activation_performed": {"const": false},
    "model_promotion_performed": {"const": false},
    "external_publication_performed": {"const": false},
    "manifest_contract_version": {"const": "portfolio-demo-manifest-v2"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
