{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "controlled_fabric_pilot_plan_v1",
  "type": "object",
  "required": [
    "pilot_id",
    "pilot_revision",
    "pilot_state",
    "candidate_id",
    "candidate_version",
    "bundle_id",
    "bundle_sha256",
    "recovery_id",
    "repository",
    "code_commit_sha",
    "code_tree_sha",
    "environment",
    "workspace_name",
    "lakehouse_name",
    "capacity_name",
    "credential_references",
    "notebook_paths",
    "contract_paths",
    "allowed_tables",
    "rollback_steps",
    "max_duration_minutes",
    "max_capacity_units",
    "max_forecast_records",
    "max_prediction_rows",
    "max_metric_rows",
    "max_failed_quality_checks",
    "max_notebook_retries",
    "actor",
    "review_ticket",
    "reason",
    "planned_at_utc",
    "execution_mode",
    "manual_execution_required",
    "automatic_execution_allowed",
    "schedule_activation_allowed",
    "execution_authorized",
    "execution_performed",
    "deployment_authorized",
    "active_model_before",
    "active_model_expected_after",
    "active_model_unchanged",
    "credential_values_recorded",
    "source_evidence_mutated",
    "pilot_plan_contract_version",
    "plan_hash"
  ],
  "properties": {
    "pilot_id": {"type": "string", "pattern": "^fpl-[0-9a-f]{24}$"},
    "pilot_revision": {"const": 1},
    "pilot_state": {"const": "draft"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "code_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "code_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment": {"enum": ["sandbox", "development", "test", "non-production"]},
    "workspace_name": {"type": "string", "minLength": 1},
    "lakehouse_name": {"type": "string", "minLength": 1},
    "capacity_name": {"type": "string", "minLength": 1},
    "credential_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}
    },
    "notebook_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contract_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_tables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rollback_steps": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "max_duration_minutes": {"type": "integer", "minimum": 1, "maximum": 240},
    "max_capacity_units": {"type": "number", "exclusiveMinimum": 0, "maximum": 128},
    "max_forecast_records": {"type": "integer", "minimum": 1, "maximum": 40},
    "max_prediction_rows": {"type": "integer", "minimum": 1, "maximum": 10000000},
    "max_metric_rows": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "max_failed_quality_checks": {"type": "integer", "minimum": 0},
    "max_notebook_retries": {"type": "integer", "minimum": 0},
    "actor": {"type": "string", "minLength": 1},
    "review_ticket": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 20},
    "planned_at_utc": {"type": "string", "format": "date-time"},
    "execution_mode": {"const": "manual"},
    "manual_execution_required": {"const": true},
    "automatic_execution_allowed": {"const": false},
    "schedule_activation_allowed": {"const": false},
    "execution_authorized": {"const": false},
    "execution_performed": {"const": false},
    "deployment_authorized": {"const": false},
    "active_model_before": {"const": "ridge_weather_lag"},
    "active_model_expected_after": {"const": "ridge_weather_lag"},
    "active_model_unchanged": {"const": true},
    "credential_values_recorded": {"const": false},
    "source_evidence_mutated": {"const": false},
    "pilot_plan_contract_version": {"const": "controlled-fabric-pilot-plan-v1"},
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
