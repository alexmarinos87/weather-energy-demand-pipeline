{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "prediction_interval_health_check_v1",
  "type": "object",
  "required": [
    "monitor_run_id",
    "monitor_timestamp_utc",
    "monitor_as_of_utc",
    "check_scope",
    "severity",
    "check_name",
    "observed_value",
    "threshold_value",
    "comparator",
    "passed",
    "details",
    "source_area",
    "resource_id",
    "city",
    "requested_horizon_minutes",
    "model_name",
    "feature_contract_version",
    "target_coverage_level",
    "interval_contract_version",
    "latest_interval_run_id",
    "policy_version",
    "monitoring_contract_version"
  ],
  "properties": {
    "monitor_run_id": {"type": "string", "minLength": 1},
    "monitor_timestamp_utc": {"type": "string", "format": "date-time"},
    "monitor_as_of_utc": {"type": "string", "format": "date-time"},
    "check_scope": {
      "enum": ["history", "freshness", "calibration", "coverage", "width"]
    },
    "severity": {"enum": ["error", "warning"]},
    "check_name": {"type": "string", "minLength": 1},
    "observed_value": {"type": "number"},
    "threshold_value": {"type": "number"},
    "comparator": {"enum": [">=", "<=", "=="]},
    "passed": {"type": "boolean"},
    "details": {"type": "string", "minLength": 1},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "requested_horizon_minutes": {"type": "integer", "minimum": 1},
    "model_name": {"type": "string", "minLength": 1},
    "feature_contract_version": {"type": "string", "minLength": 1},
    "target_coverage_level": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "interval_contract_version": {"type": "string", "minLength": 1},
    "latest_interval_run_id": {"type": "string", "minLength": 1},
    "policy_version": {"const": "prediction-interval-monitoring-policy-v1"},
    "monitoring_contract_version": {
      "const": "prediction-interval-monitoring-v1"
    }
  },
  "additionalProperties": true
}
