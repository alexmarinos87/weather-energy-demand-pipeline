{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "target_weather_promotion_check_v1",
  "type": "object",
  "required": [
    "assessment_id",
    "assessment_timestamp_utc",
    "check_scope",
    "check_name",
    "observed_value",
    "threshold_value",
    "comparator",
    "passed",
    "details",
    "policy_version",
    "assessment_contract_version"
  ],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "assessment_timestamp_utc": {"type": "string", "format": "date-time"},
    "check_scope": {"enum": ["model_slice", "weather_quality", "completeness"]},
    "check_name": {"type": "string", "minLength": 1},
    "observed_value": {"type": "number"},
    "threshold_value": {"type": "number"},
    "comparator": {"enum": [">=", "<=", "=="]},
    "passed": {"type": "boolean"},
    "details": {"type": "string", "minLength": 1},
    "source_area": {"type": ["string", "null"]},
    "resource_id": {"type": ["string", "null"]},
    "city": {"type": ["string", "null"]},
    "requested_horizon_minutes": {"type": ["integer", "null"], "minimum": 1},
    "split": {"type": ["string", "null"]},
    "origin_fold": {"type": ["integer", "null"], "minimum": 1},
    "forecast_provider": {"type": ["string", "null"]},
    "forecast_model": {"type": ["string", "null"]},
    "forecast_lead_time_bucket": {
      "type": ["string", "null"],
      "enum": [null, "00-06h", "06-12h", "12-24h", "24-48h", "48h+"]
    },
    "policy_version": {"const": "target-weather-promotion-policy-v1"},
    "assessment_contract_version": {"const": "target-weather-promotion-assessment-v1"}
  },
  "additionalProperties": true
}
