{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "post_pilot_closure_verification_v1",
  "type": "object",
  "required": [
    "verification_id",
    "verification_kind",
    "closure_id",
    "pilot_id",
    "manifest_hash",
    "verification_status",
    "verified_at_utc",
    "item_count",
    "total_size_bytes",
    "active_model_unchanged",
    "model_registry_mutation_allowed",
    "authorization_reuse_allowed",
    "deployment_authorized",
    "model_activation_authorized",
    "source_evidence_mutated",
    "permanent_deletion_allowed",
    "closure_verification_contract_version",
    "verification_hash"
  ],
  "properties": {
    "verification_id": {"type": "string", "pattern": "^pcv-[0-9a-f]{24}$"},
    "verification_kind": {"enum": ["archive", "recovery"]},
    "closure_id": {"type": "string", "pattern": "^pcl-[0-9a-f]{24}$"},
    "pilot_id": {"type": "string", "pattern": "^fpl-[0-9a-f]{24}$"},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archive_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "recovered_directory": {"type": ["string", "null"]},
    "verification_status": {"const": "verified"},
    "verified_at_utc": {"type": "string", "format": "date-time"},
    "item_count": {"type": "integer", "minimum": 7},
    "total_size_bytes": {"type": "integer", "minimum": 0},
    "active_model_unchanged": {"const": true},
    "model_registry_mutation_allowed": {"const": false},
    "authorization_reuse_allowed": {"const": false},
    "deployment_authorized": {"const": false},
    "model_activation_authorized": {"const": false},
    "source_evidence_mutated": {"const": false},
    "permanent_deletion_allowed": {"const": false},
    "closure_verification_contract_version": {"const": "post-pilot-closure-verification-v1"},
    "verification_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
