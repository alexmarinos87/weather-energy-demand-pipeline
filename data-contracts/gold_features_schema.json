{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "weather_energy_features_v3",
  "description": "Contract for spatially scoped, analytics-ready weather-demand features with canonical UTC identity and explicit Europe/London calendar evidence.",
  "type": "object",
  "required": [
    "event_timestamp_utc",
    "event_timestamp_local",
    "event_date_local",
    "source_area",
    "resource_id",
    "city",
    "temperature",
    "humidity",
    "demand_mw",
    "weather_age_minutes",
    "hour_of_day_utc",
    "day_of_week_utc",
    "is_weekend_utc",
    "hour_of_day_local",
    "day_of_week_local",
    "is_weekend_local",
    "local_utc_offset_minutes",
    "is_dst_local",
    "calendar_timezone",
    "calendar_feature_contract_version"
  ],
  "properties": {
    "event_timestamp_utc": {"type": "string", "format": "date-time"},
    "event_timestamp_local": {"type": "string", "minLength": 1},
    "event_date_local": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "temperature": {"type": "number"},
    "humidity": {"type": "number", "minimum": 0, "maximum": 100},
    "demand_mw": {"type": "number"},
    "weather_age_minutes": {"type": "number", "minimum": 0, "maximum": 360},
    "hour_of_day_utc": {"type": "integer", "minimum": 0, "maximum": 23},
    "day_of_week_utc": {"type": "integer", "minimum": 1, "maximum": 7},
    "is_weekend_utc": {"type": "integer", "minimum": 0, "maximum": 1},
    "hour_of_day_local": {"type": "integer", "minimum": 0, "maximum": 23},
    "day_of_week_local": {"type": "integer", "minimum": 1, "maximum": 7},
    "is_weekend_local": {"type": "integer", "minimum": 0, "maximum": 1},
    "local_utc_offset_minutes": {"enum": [0, 60]},
    "is_dst_local": {"type": "integer", "minimum": 0, "maximum": 1},
    "calendar_timezone": {"const": "Europe/London"},
    "calendar_feature_contract_version": {"const": "uk-local-calendar-v1"}
  },
  "additionalProperties": true
}
