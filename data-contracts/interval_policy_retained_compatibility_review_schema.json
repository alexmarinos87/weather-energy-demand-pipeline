{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alert_delivery_performed": {"const": false},
    "compatibility_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "compatibility_run_id": {
      "pattern": "^ipca-[0-9a-f]{24}$",
      "type": "string"
    },
    "compatibility_run_timestamp_utc": {
      "format": "date-time",
      "type": "string"
    },
    "compatibility_summary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "current_policy_id": {"const": "reviewed-three-point"},
    "current_shortfall_threshold_pct_points": {"const": 3.0},
    "decision": {
      "enum": [
        "accept_non_retroactive_transition",
        "request_historical_annotation",
        "request_compatibility_reassessment"
      ]
    },
    "decision_effect": {
      "enum": [
        "non_retroactive_transition_accepted",
        "separate_historical_annotation_proposal_required",
        "new_compatibility_assessment_required"
      ]
    },
    "deployment_performed": {"const": false},
    "external_publication_performed": {"const": false},
    "fabric_execution_performed": {"const": false},
    "follow_up_human_action_required": {"type": "boolean"},
    "historical_annotation_applied": {"const": false},
    "historical_statuses_rewritten": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "monitoring_rerun_performed": {"const": false},
    "named_human_review_confirmed": {"const": true},
    "policy_version_updated": {"const": false},
    "previous_policy_id": {"const": "previous-five-point"},
    "previous_shortfall_threshold_pct_points": {"const": 5.0},
    "promotion_change_performed": {"const": false},
    "rationale": {"minLength": 20, "type": "string"},
    "requested_actions": {
      "items": {"minLength": 10, "type": "string"},
      "type": "array",
      "uniqueItems": true
    },
    "retained_evidence_mutated": {"const": false},
    "review_contract_version": {
      "const": "interval-policy-retained-compatibility-review-v1"
    },
    "review_id": {
      "pattern": "^ipcr-[0-9a-f]{24}$",
      "type": "string"
    },
    "review_revision": {"const": 1},
    "review_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "review_ticket": {"minLength": 1, "type": "string"},
    "reviewed_at_utc": {"format": "date-time", "type": "string"},
    "reviewer_name": {"minLength": 1, "type": "string"},
    "reviewer_role": {"minLength": 1, "type": "string"},
    "scenario_evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "changed_slice_count": {"minimum": 0, "type": "integer"},
          "compatibility_classification": {
            "enum": [
              "fully_compatible",
              "slice_change_without_scenario_change",
              "scenario_status_escalation"
            ]
          },
          "current_policy_status": {
            "enum": ["healthy", "warning", "failed"]
          },
          "human_review_required": {"type": "boolean"},
          "newly_failed_slice_count": {"minimum": 0, "type": "integer"},
          "previous_policy_status": {
            "enum": ["healthy", "warning", "failed"]
          },
          "retained_monitor_status": {
            "enum": ["healthy", "warning", "failed"]
          },
          "retained_status_compatibility": {
            "enum": [
              "matches_both_policies",
              "matches_previous_policy_only",
              "matches_current_policy_only",
              "matches_neither_policy"
            ]
          },
          "scenario": {"minLength": 1, "type": "string"}
        },
        "required": [
          "scenario",
          "retained_monitor_status",
          "previous_policy_status",
          "current_policy_status",
          "compatibility_classification",
          "retained_status_compatibility",
          "changed_slice_count",
          "newly_failed_slice_count",
          "human_review_required"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schedule_change_performed": {"const": false},
    "threshold_activation_performed": {"const": false},
    "trend_run_id": {"minLength": 1, "type": "string"}
  },
  "required": [
    "review_id",
    "review_revision",
    "compatibility_run_id",
    "compatibility_run_timestamp_utc",
    "trend_run_id",
    "compatibility_summary_sha256",
    "compatibility_manifest_sha256",
    "previous_policy_id",
    "previous_shortfall_threshold_pct_points",
    "current_policy_id",
    "current_shortfall_threshold_pct_points",
    "decision",
    "decision_effect",
    "reviewer_name",
    "reviewer_role",
    "review_ticket",
    "rationale",
    "requested_actions",
    "reviewed_at_utc",
    "scenario_evidence",
    "named_human_review_confirmed",
    "follow_up_human_action_required",
    "historical_statuses_rewritten",
    "historical_annotation_applied",
    "retained_evidence_mutated",
    "monitoring_rerun_performed",
    "policy_version_updated",
    "threshold_activation_performed",
    "interval_recalibration_performed",
    "model_change_performed",
    "fabric_execution_performed",
    "schedule_change_performed",
    "promotion_change_performed",
    "alert_delivery_performed",
    "deployment_performed",
    "external_publication_performed",
    "review_contract_version",
    "review_sha256"
  ],
  "title": "interval-policy-retained-compatibility-review-v1",
  "type": "object"
}
