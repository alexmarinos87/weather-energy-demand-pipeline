{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calibrated_prediction_interval_v1",
  "type": "object",
  "required": [
    "interval_run_id",
    "interval_run_timestamp_utc",
    "point_prediction_run_id",
    "source_area",
    "resource_id",
    "city",
    "feature_timestamp_utc",
    "event_timestamp_utc",
    "requested_horizon_minutes",
    "model_name",
    "feature_contract_version",
    "actual_demand_mw",
    "point_prediction_mw",
    "target_coverage_level",
    "lower_prediction_mw",
    "upper_prediction_mw",
    "interval_width_mw",
    "interval_covered",
    "calibration_method",
    "calibration_observation_count",
    "calibration_quantile_rank",
    "calibration_radius_mw",
    "calibration_feature_start_utc",
    "calibration_feature_end_utc",
    "calibration_label_available_through_utc",
    "point_model_trained_through_utc",
    "interval_contract_version"
  ],
  "properties": {
    "interval_run_id": {"type": "string", "minLength": 1},
    "interval_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "point_prediction_run_id": {"type": "string", "minLength": 1},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "feature_timestamp_utc": {"type": "string", "format": "date-time"},
    "event_timestamp_utc": {"type": "string", "format": "date-time"},
    "requested_horizon_minutes": {"type": "integer", "minimum": 1},
    "model_name": {"type": "string", "minLength": 1},
    "feature_contract_version": {"type": "string", "minLength": 1},
    "evaluation_origin_fold": {"type": ["integer", "null"], "minimum": 1},
    "actual_demand_mw": {"type": "number"},
    "point_prediction_mw": {"type": "number"},
    "target_coverage_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "lower_prediction_mw": {"type": "number"},
    "upper_prediction_mw": {"type": "number"},
    "interval_width_mw": {"type": "number", "minimum": 0},
    "interval_covered": {"type": "boolean"},
    "calibration_method": {"const": "absolute_residual_quantile"},
    "calibration_observation_count": {"type": "integer", "minimum": 1},
    "calibration_quantile_rank": {"type": "integer", "minimum": 1},
    "calibration_radius_mw": {"type": "number", "minimum": 0},
    "calibration_feature_start_utc": {"type": "string", "format": "date-time"},
    "calibration_feature_end_utc": {"type": "string", "format": "date-time"},
    "calibration_label_available_through_utc": {"type": "string", "format": "date-time"},
    "point_model_trained_through_utc": {"type": "string", "format": "date-time"},
    "interval_contract_version": {"const": "split-conformal-absolute-residual-v1"}
  },
  "additionalProperties": true
}
