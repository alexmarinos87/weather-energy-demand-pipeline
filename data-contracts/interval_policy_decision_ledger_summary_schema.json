{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval_policy_decision_ledger_summary_v1",
  "type": "object",
  "required": [
    "ledger_run_id", "ledger_run_timestamp_utc", "decision_count",
    "sensitivity_run_count", "target_candidate_count",
    "retain_active_policy_count", "reject_candidate_count",
    "request_candidate_revision_count", "first_decision_timestamp_utc",
    "last_decision_timestamp_utc", "conflict_count", "human_review_required",
    "ledger_contract_version", "threshold_activation_authorized",
    "active_policy_updated", "candidate_thresholds_activated",
    "retained_evidence_mutated", "interval_recalibration_performed",
    "model_change_performed", "schedule_change_performed",
    "promotion_change_performed", "alert_delivery_performed",
    "deployment_performed", "external_publication_performed"
  ],
  "properties": {
    "ledger_run_id": {"type": "string", "pattern": "^ipl-[0-9a-f]{24}$"},
    "ledger_run_timestamp_utc": {"type": "string", "format": "date-time"},
    "decision_count": {"type": "integer", "minimum": 1},
    "sensitivity_run_count": {"type": "integer", "minimum": 1},
    "target_candidate_count": {"type": "integer", "minimum": 1},
    "retain_active_policy_count": {"type": "integer", "minimum": 0},
    "reject_candidate_count": {"type": "integer", "minimum": 0},
    "request_candidate_revision_count": {"type": "integer", "minimum": 0},
    "first_decision_timestamp_utc": {"type": "string", "format": "date-time"},
    "last_decision_timestamp_utc": {"type": "string", "format": "date-time"},
    "conflict_count": {"const": 0},
    "human_review_required": {"type": "boolean"},
    "ledger_contract_version": {"const": "interval-policy-decision-ledger-v1"},
    "threshold_activation_authorized": {"const": false},
    "active_policy_updated": {"const": false},
    "candidate_thresholds_activated": {"const": false},
    "retained_evidence_mutated": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "schedule_change_performed": {"const": false},
    "promotion_change_performed": {"const": false},
    "alert_delivery_performed": {"const": false},
    "deployment_performed": {"const": false},
    "external_publication_performed": {"const": false}
  },
  "additionalProperties": false
}
