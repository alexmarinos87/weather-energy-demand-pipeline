{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alert_delivery_performed": {"const": false},
    "annotation_count": {"minimum": 1, "type": "integer"},
    "annotation_storage_change_authorized": {"const": false},
    "annotation_storage_change_created": {"const": false},
    "annotations_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "compatibility_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "compatibility_run_id": {"pattern": "^ipca-[0-9a-f]{24}$", "type": "string"},
    "compatibility_summary_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "decision": {
      "enum": [
        "accept_for_separate_annotation_storage_change",
        "reject_historical_annotation_proposal",
        "request_historical_annotation_proposal_revision"
      ]
    },
    "decision_effect": {
      "enum": [
        "separate_annotation_storage_change_request_required",
        "no_further_action_recorded",
        "revised_historical_annotation_proposal_required"
      ]
    },
    "deployment_performed": {"const": false},
    "external_publication_performed": {"const": false},
    "fabric_execution_performed": {"const": false},
    "follow_up_human_action_required": {"type": "boolean"},
    "historical_annotation_applied": {"const": false},
    "historical_statuses_rewritten": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "monitoring_rerun_performed": {"const": false},
    "named_human_review_confirmed": {"const": true},
    "next_action": {
      "enum": [
        "separate_annotation_storage_change_request_required",
        "no_further_action_recorded",
        "revised_historical_annotation_proposal_required"
      ]
    },
    "policy_version_updated": {"const": false},
    "promotion_change_performed": {"const": false},
    "rationale": {"minLength": 20, "type": "string"},
    "requested_action_responses_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "requested_actions_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "requested_updates": {
      "items": {"minLength": 10, "type": "string"},
      "type": "array",
      "uniqueItems": true
    },
    "retained_evidence_mutated": {"const": false},
    "review_contract_version": {
      "const": "interval-policy-historical-annotation-proposal-review-v1"
    },
    "review_id": {"pattern": "^iphapr-[0-9a-f]{24}$", "type": "string"},
    "review_revision": {"const": 1},
    "review_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "review_ticket": {"minLength": 1, "type": "string"},
    "reviewed_at_utc": {"format": "date-time", "type": "string"},
    "reviewer_name": {"minLength": 1, "type": "string"},
    "reviewer_role": {"minLength": 1, "type": "string"},
    "schedule_change_performed": {"const": false},
    "source_compatibility_evidence_mutated": {"const": false},
    "source_proposal_id": {"pattern": "^iphap-[0-9a-f]{24}$", "type": "string"},
    "source_proposal_mutated": {"const": false},
    "source_proposal_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "source_review_id": {"pattern": "^ipcr-[0-9a-f]{24}$", "type": "string"},
    "source_review_mutated": {"const": false},
    "source_review_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "threshold_activation_performed": {"const": false},
    "trend_run_id": {"minLength": 1, "type": "string"}
  },
  "required": [
    "review_id",
    "review_revision",
    "source_proposal_id",
    "source_proposal_sha256",
    "source_review_id",
    "source_review_sha256",
    "compatibility_run_id",
    "trend_run_id",
    "compatibility_summary_sha256",
    "compatibility_manifest_sha256",
    "annotation_count",
    "annotations_sha256",
    "requested_actions_sha256",
    "requested_action_responses_sha256",
    "decision",
    "decision_effect",
    "reviewer_name",
    "reviewer_role",
    "review_ticket",
    "rationale",
    "requested_updates",
    "reviewed_at_utc",
    "named_human_review_confirmed",
    "follow_up_human_action_required",
    "next_action",
    "annotation_storage_change_authorized",
    "annotation_storage_change_created",
    "historical_annotation_applied",
    "historical_statuses_rewritten",
    "source_proposal_mutated",
    "source_review_mutated",
    "source_compatibility_evidence_mutated",
    "retained_evidence_mutated",
    "monitoring_rerun_performed",
    "policy_version_updated",
    "threshold_activation_performed",
    "interval_recalibration_performed",
    "model_change_performed",
    "fabric_execution_performed",
    "schedule_change_performed",
    "promotion_change_performed",
    "alert_delivery_performed",
    "deployment_performed",
    "external_publication_performed",
    "review_contract_version",
    "review_sha256"
  ],
  "title": "interval-policy-historical-annotation-proposal-review-v1",
  "type": "object"
}
