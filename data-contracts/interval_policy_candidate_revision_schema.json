{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interval_policy_candidate_revision_v1",
  "type": "object",
  "required": [
    "revision_id",
    "revision_number",
    "created_at_utc",
    "source_decision_id",
    "source_decision_sha256",
    "source_decision",
    "source_sensitivity_run_id",
    "source_sensitivity_summary_sha256",
    "source_candidate_id",
    "source_candidate_version",
    "revised_candidate_id",
    "revised_candidate_version",
    "requested_changes",
    "evidence_notes",
    "proposed_policy",
    "proposed_policy_sha256",
    "active_policy_snapshot",
    "active_policy_sha256",
    "changed_thresholds",
    "changed_threshold_count",
    "proposed_by",
    "proposer_role",
    "revision_ticket",
    "rationale",
    "human_review_required",
    "candidate_revision_contract_version",
    "revision_sha256",
    "threshold_activation_authorized",
    "candidate_thresholds_activated",
    "active_policy_updated",
    "retained_evidence_mutated",
    "interval_recalibration_performed",
    "model_change_performed",
    "schedule_change_performed",
    "promotion_change_performed",
    "alert_delivery_performed",
    "deployment_performed",
    "external_publication_performed"
  ],
  "properties": {
    "revision_id": {"type": "string", "pattern": "^ipcr-[0-9a-f]{24}$"},
    "revision_number": {"const": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source_decision_id": {"type": "string", "minLength": 1},
    "source_decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_decision": {"enum": ["request_candidate_revision", "request_revision"]},
    "source_sensitivity_run_id": {"type": "string", "pattern": "^ips-[0-9a-f]{24}$"},
    "source_sensitivity_summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "source_candidate_version": {"type": "string", "minLength": 1},
    "revised_candidate_id": {"type": "string", "minLength": 1},
    "revised_candidate_version": {"type": "string", "minLength": 1},
    "requested_changes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_notes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "proposed_policy": {"type": "object", "minProperties": 1},
    "proposed_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "active_policy_snapshot": {"type": "object", "minProperties": 1},
    "active_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changed_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "active_value", "proposed_value"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "active_value": {},
          "proposed_value": {}
        },
        "additionalProperties": false
      }
    },
    "changed_threshold_count": {"type": "integer", "minimum": 1},
    "proposed_by": {"type": "string", "minLength": 1},
    "proposer_role": {"type": "string", "minLength": 1},
    "revision_ticket": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "human_review_required": {"const": true},
    "candidate_revision_contract_version": {"const": "interval-policy-candidate-revision-v1"},
    "revision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "threshold_activation_authorized": {"const": false},
    "candidate_thresholds_activated": {"const": false},
    "active_policy_updated": {"const": false},
    "retained_evidence_mutated": {"const": false},
    "interval_recalibration_performed": {"const": false},
    "model_change_performed": {"const": false},
    "schedule_change_performed": {"const": false},
    "promotion_change_performed": {"const": false},
    "alert_delivery_performed": {"const": false},
    "deployment_performed": {"const": false},
    "external_publication_performed": {"const": false}
  },
  "additionalProperties": true
}
