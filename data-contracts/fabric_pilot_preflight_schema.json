{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "controlled_fabric_pilot_preflight_v1",
  "type": "object",
  "required": [
    "preflight_id",
    "preflight_revision",
    "pilot_id",
    "plan_hash",
    "candidate_id",
    "bundle_id",
    "recovery_id",
    "preflight_timestamp_utc",
    "repository_commit_sha",
    "repository_tree_sha",
    "provider_health_monitor_run_id",
    "environment_snapshot_id",
    "verified_credential_references",
    "repository_files",
    "checks",
    "preflight_status",
    "check_count",
    "passed_check_count",
    "failed_check_count",
    "manual_authorization_required",
    "automatic_authorization_allowed",
    "execution_authorized",
    "execution_performed",
    "schedule_activation_allowed",
    "deployment_authorized",
    "active_model_unchanged",
    "credential_values_recorded",
    "source_evidence_mutated",
    "preflight_contract_version",
    "preflight_hash"
  ],
  "properties": {
    "preflight_id": {"type": "string", "pattern": "^fpf-[0-9a-f]{24}$"},
    "preflight_revision": {"const": 1},
    "pilot_id": {"type": "string", "pattern": "^fpl-[0-9a-f]{24}$"},
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "recovery_id": {"type": "string", "minLength": 1},
    "preflight_timestamp_utc": {"type": "string", "format": "date-time"},
    "repository_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provider_health_monitor_run_id": {"type": "string", "minLength": 1},
    "environment_snapshot_id": {"type": "string", "minLength": 1},
    "verified_credential_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}
    },
    "repository_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_sequence", "file_role", "repository_path", "size_bytes", "sha256"],
        "properties": {
          "file_sequence": {"type": "integer", "minimum": 1},
          "file_role": {"enum": ["notebook", "contract"]},
          "repository_path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_sequence", "check_scope", "check_name", "passed", "observed_value", "expected_value", "details"],
        "properties": {
          "check_sequence": {"type": "integer", "minimum": 1},
          "check_scope": {"enum": ["governance", "repository", "environment", "credentials", "provider_health"]},
          "check_name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "observed_value": {"type": "string"},
          "expected_value": {"type": "string"},
          "details": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "preflight_status": {"enum": ["blocked", "eligible_for_human_authorization"]},
    "check_count": {"type": "integer", "minimum": 1},
    "passed_check_count": {"type": "integer", "minimum": 0},
    "failed_check_count": {"type": "integer", "minimum": 0},
    "manual_authorization_required": {"const": true},
    "automatic_authorization_allowed": {"const": false},
    "execution_authorized": {"const": false},
    "execution_performed": {"const": false},
    "schedule_activation_allowed": {"const": false},
    "deployment_authorized": {"const": false},
    "active_model_unchanged": {"const": true},
    "credential_values_recorded": {"const": false},
    "source_evidence_mutated": {"const": false},
    "preflight_contract_version": {"const": "controlled-fabric-pilot-preflight-v1"},
    "preflight_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
