{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "elapsed_seasonal_baseline_prediction_v1",
  "type": "object",
  "required": [
    "run_id",
    "run_timestamp_utc",
    "source_area",
    "resource_id",
    "city",
    "feature_timestamp_utc",
    "event_timestamp_utc",
    "requested_horizon_minutes",
    "target_tolerance_minutes",
    "horizon_steps",
    "horizon_minutes",
    "target_delay_minutes",
    "split",
    "model_name",
    "model_fit_required",
    "current_demand_mw",
    "actual_demand_mw",
    "predicted_demand_mw",
    "absolute_error_mw",
    "squared_error_mw2",
    "trained_through_utc",
    "training_observation_count",
    "feature_contract_version",
    "seasonal_reference_tolerance_minutes",
    "previous_day_eligible_count",
    "previous_day_matched_count",
    "previous_day_coverage_pct",
    "previous_week_eligible_count",
    "previous_week_matched_count",
    "previous_week_coverage_pct",
    "seasonal_baseline_contract_version",
    "evaluation_contract_version"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "run_timestamp_utc": {"type": "string", "format": "date-time"},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "feature_timestamp_utc": {"type": "string", "format": "date-time"},
    "event_timestamp_utc": {"type": "string", "format": "date-time"},
    "requested_horizon_minutes": {"type": "integer", "enum": [30, 60]},
    "target_tolerance_minutes": {"type": "integer", "minimum": 0},
    "horizon_steps": {"type": "integer", "minimum": 1},
    "horizon_minutes": {"type": "number", "exclusiveMinimum": 0},
    "target_delay_minutes": {"type": "number", "minimum": 0},
    "split": {"enum": ["validation", "test"]},
    "model_name": {
      "enum": [
        "persistence_current_value",
        "seasonal_previous_day",
        "seasonal_previous_week",
        "ridge_weather_lag"
      ]
    },
    "model_fit_required": {"type": "boolean"},
    "current_demand_mw": {"type": "number"},
    "actual_demand_mw": {"type": "number"},
    "predicted_demand_mw": {"type": "number"},
    "absolute_error_mw": {"type": "number", "minimum": 0},
    "squared_error_mw2": {"type": "number", "minimum": 0},
    "trained_through_utc": {"type": "string", "format": "date-time"},
    "training_observation_count": {"type": "integer", "minimum": 1},
    "feature_contract_version": {
      "enum": ["time-horizon-v1", "time-horizon-uk-calendar-v1"]
    },
    "seasonal_reference_tolerance_minutes": {"type": "integer", "minimum": 0},
    "previous_day_eligible_count": {"type": "integer", "minimum": 1},
    "previous_day_matched_count": {"type": "integer", "minimum": 1},
    "previous_day_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "previous_week_eligible_count": {"type": "integer", "minimum": 1},
    "previous_week_matched_count": {"type": "integer", "minimum": 1},
    "previous_week_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "seasonal_reference_period_minutes": {"type": ["integer", "null"], "enum": [null, 1440, 10080]},
    "seasonal_reference_ideal_timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "seasonal_reference_timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "seasonal_reference_demand_mw": {"type": ["number", "null"]},
    "seasonal_reference_offset_minutes": {"type": ["number", "null"]},
    "seasonal_reference_absolute_offset_minutes": {"type": ["number", "null"], "minimum": 0},
    "seasonal_reference_source_age_minutes": {"type": ["number", "null"], "minimum": 0},
    "seasonal_baseline_contract_version": {"const": "elapsed-seasonal-v1"},
    "evaluation_contract_version": {"enum": ["fixed-holdout-v1", "rolling-origin-v1"]},
    "origin_fold": {"type": ["integer", "null"], "minimum": 1},
    "origin_count": {"type": ["integer", "null"], "minimum": 2},
    "origin_cutoff_utc": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"model_name": {"const": "ridge_weather_lag"}}},
      "then": {"properties": {"model_fit_required": {"const": true}}},
      "else": {"properties": {"model_fit_required": {"const": false}}}
    },
    {
      "if": {"properties": {"model_name": {"const": "seasonal_previous_day"}}},
      "then": {
        "required": [
          "seasonal_reference_period_minutes",
          "seasonal_reference_ideal_timestamp_utc",
          "seasonal_reference_timestamp_utc",
          "seasonal_reference_demand_mw",
          "seasonal_reference_offset_minutes",
          "seasonal_reference_absolute_offset_minutes",
          "seasonal_reference_source_age_minutes"
        ],
        "properties": {"seasonal_reference_period_minutes": {"const": 1440}}
      }
    },
    {
      "if": {"properties": {"model_name": {"const": "seasonal_previous_week"}}},
      "then": {
        "required": [
          "seasonal_reference_period_minutes",
          "seasonal_reference_ideal_timestamp_utc",
          "seasonal_reference_timestamp_utc",
          "seasonal_reference_demand_mw",
          "seasonal_reference_offset_minutes",
          "seasonal_reference_absolute_offset_minutes",
          "seasonal_reference_source_age_minutes"
        ],
        "properties": {"seasonal_reference_period_minutes": {"const": 10080}}
      }
    },
    {
      "if": {"properties": {"evaluation_contract_version": {"const": "rolling-origin-v1"}}},
      "then": {"required": ["origin_fold", "origin_count", "origin_cutoff_utc"]}
    }
  ],
  "additionalProperties": true
}
