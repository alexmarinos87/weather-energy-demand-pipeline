{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "weather_energy_baseline_evaluation_v1",
  "description": "Contract for one leakage-safe baseline prediction row.",
  "type": "object",
  "required": [
    "run_id",
    "run_timestamp_utc",
    "source_area",
    "resource_id",
    "city",
    "event_timestamp_utc",
    "split",
    "model_name",
    "actual_demand_mw",
    "predicted_demand_mw",
    "trained_through_utc",
    "feature_contract_version"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "run_timestamp_utc": {"type": "string", "format": "date-time"},
    "source_area": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "event_timestamp_utc": {"type": "string", "format": "date-time"},
    "split": {"enum": ["validation", "test"]},
    "model_name": {"enum": ["persistence_lag_1", "ridge_weather_lag"]},
    "actual_demand_mw": {"type": "number"},
    "predicted_demand_mw": {"type": "number"},
    "absolute_error_mw": {"type": "number", "minimum": 0},
    "squared_error_mw2": {"type": "number", "minimum": 0},
    "trained_through_utc": {"type": "string", "format": "date-time"},
    "feature_contract_version": {"const": "baseline-v1"}
  },
  "additionalProperties": true
}
