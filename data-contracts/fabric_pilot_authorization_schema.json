{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "controlled_fabric_pilot_authorization_v1",
  "type": "object",
  "required": [
    "authorization_id",
    "authorization_revision",
    "authorization_state",
    "pilot_id",
    "plan_hash",
    "preflight_id",
    "preflight_hash",
    "candidate_id",
    "bundle_id",
    "recovery_id",
    "repository",
    "code_commit_sha",
    "code_tree_sha",
    "environment",
    "workspace_name",
    "lakehouse_name",
    "capacity_name",
    "authorizer",
    "operator",
    "review_ticket",
    "reason",
    "authorized_at_utc",
    "valid_from_utc",
    "valid_until_utc",
    "authorization_window_minutes",
    "single_use",
    "authorization_consumed",
    "authorization_revocable",
    "execution_authorized",
    "execution_performed",
    "manual_execution_required",
    "automatic_execution_allowed",
    "schedule_activation_allowed",
    "deployment_authorized",
    "model_activation_authorized",
    "active_model_before",
    "active_model_expected_after",
    "active_model_unchanged",
    "credential_values_recorded",
    "source_evidence_mutated",
    "authorization_contract_version",
    "authorization_hash"
  ],
  "properties": {
    "authorization_id": {"type": "string", "pattern": "^fpa-[0-9a-f]{24}$"},
    "authorization_revision": {"const": 1},
    "authorization_state": {"const": "authorized"},
    "pilot_id": {"type": "string", "pattern": "^fpl-[0-9a-f]{24}$"},
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_id": {"type": "string", "pattern": "^fpf-[0-9a-f]{24}$"},
    "preflight_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "recovery_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "code_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "code_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment": {"enum": ["sandbox", "development", "test", "non-production"]},
    "workspace_name": {"type": "string", "minLength": 1},
    "lakehouse_name": {"type": "string", "minLength": 1},
    "capacity_name": {"type": "string", "minLength": 1},
    "authorizer": {"type": "string", "minLength": 1},
    "operator": {"type": "string", "minLength": 1},
    "review_ticket": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 20},
    "authorized_at_utc": {"type": "string", "format": "date-time"},
    "valid_from_utc": {"type": "string", "format": "date-time"},
    "valid_until_utc": {"type": "string", "format": "date-time"},
    "authorization_window_minutes": {"type": "number", "exclusiveMinimum": 0, "maximum": 480},
    "single_use": {"const": true},
    "authorization_consumed": {"const": false},
    "authorization_revocable": {"const": true},
    "execution_authorized": {"const": true},
    "execution_performed": {"const": false},
    "manual_execution_required": {"const": true},
    "automatic_execution_allowed": {"const": false},
    "schedule_activation_allowed": {"const": false},
    "deployment_authorized": {"const": false},
    "model_activation_authorized": {"const": false},
    "active_model_before": {"const": "ridge_weather_lag"},
    "active_model_expected_after": {"const": "ridge_weather_lag"},
    "active_model_unchanged": {"const": true},
    "credential_values_recorded": {"const": false},
    "source_evidence_mutated": {"const": false},
    "authorization_contract_version": {"const": "controlled-fabric-pilot-authorization-v1"},
    "authorization_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
